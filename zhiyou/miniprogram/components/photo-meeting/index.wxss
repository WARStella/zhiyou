:host { display: block; width: 100%; }
/* 原生 button 默认整行宽；在 flex 行里要显式收成内容宽度（2026-10-24） */
.pm-btn { width: auto; flex: 0 0 auto; background: var(--brand-100); color: var(--brand-600); }
.photo-meeting { margin-top: 0; padding-top: 0; border-top: none; }
.heading, .candidate-name { font-size: var(--fs-body); font-weight: 600; color: var(--ink-900); }
.description { font-size: var(--fs-sm); line-height: 1.6; color: var(--ink-500); margin-top: 10rpx; }
.actions { display: flex; flex-wrap: wrap; margin-top: 14rpx; gap: 12rpx; }
.actions .pm-btn { margin: 0; }
.photo { width: 100%; height: 280rpx; margin-top: 16rpx; border-radius: var(--r-sm); background: var(--surface-2); }
.lines { display: flex; flex-wrap: wrap; margin-top: 12rpx; gap: 10rpx; }
/* 识别出的文字是"点一下填进输入框"的快捷操作 —— 热区做到 72rpx，
   并给按压态（组件样式隔离，不能用 app.wxss 里的 .tap-hover） */
.line {
  display: inline-flex; align-items: center; box-sizing: border-box; min-height: 72rpx;
  background: var(--brand-100); color: var(--brand-600); border-radius: var(--r-sm);
  padding: 10rpx 18rpx; font-size: var(--fs-sm); word-break: break-all;
}
.line-hover { background: var(--brand-200); }
.uncertain { background: var(--warn-bg); color: var(--warn); }
.search-row { display: flex; align-items: center; margin-top: 16rpx; gap: 12rpx; }
.keyword { flex: 1; width: 0; min-width: 0; padding: 12rpx; height: 56rpx; border: 1rpx solid var(--brand-200); border-radius: var(--r-sm); font-size: var(--fs-body); }
.search-row .pm-btn { margin: 0; flex-shrink: 0; }
.candidate { padding-top: 18rpx; margin-top: 18rpx; border-top: 1rpx solid var(--line); }
.error { margin-top: 12rpx; color: var(--danger); background: var(--danger-bg); border-radius: var(--r-sm); padding: 12rpx; font-size: var(--fs-sm); }

.pm-btn { border-radius: var(--r-pill); font-size: var(--fs-sm); }
.pm-btn::after { border: none; }
/* 主按钮跟行程页同一套浅蓝渐变（2026-10-23）：浅底必须配深蓝字，
   原来写死的白字压在浅蓝上几乎看不清。 */
.pm-btn-primary { color: var(--btn-ink); background: linear-gradient(135deg, var(--btn-g1) 0%, var(--btn-mid) 62%, var(--btn-g2) 100%); box-shadow: 0 4rpx 12rpx var(--btn-shadow); }
.pm-btn.button-disabled, .pm-btn:disabled { background: var(--line-strong); color: var(--ink-500); box-shadow: none; }

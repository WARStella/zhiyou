:host { position: static; }
.guide-fab {
  position: fixed;
  z-index: 100;
  width: 64px;
  height: 64px;
  box-sizing: border-box;
  border: 2px solid var(--surface);
  border-radius: 32px;
  background-color: var(--brand-600);
  color: var(--surface);
  box-shadow: 0 4px 14px var(--brand-shadow-color);
}
.guide-fab-dragging { background-color: var(--brand-800); box-shadow: 0 6px 18px var(--brand-shadow-color); }
.guide-fab-icon, .guide-fab-label { pointer-events: none; }
.guide-fab-icon {
  position: absolute;
  left: 16px;
  top: 9px;
  width: 28px;
  height: 23px;
  box-sizing: border-box;
  border: 2px solid var(--surface);
  border-radius: 8px 8px 8px 2px;
  font-size: 11px;
  font-weight: bold;
  line-height: 19px;
  text-align: center;
}
.guide-fab-label {
  position: absolute;
  left: 2px;
  top: 35px;
  width: 56px;
  font-size: 11px;
  line-height: 17px;
  text-align: center;
  white-space: nowrap;
}

{
  "meta": {
    "name": "需求解析样例集（冻结集）",
    "version": "v1.1",
    "createdAt": "2026-11-05",
    "purpose": "与开发集分离的留出集，用于回答“换一批没见过的说法，解析还准不准”。冻结集一经确定不再修改；任何改动都要记录原因并同时保留旧版本结果。",
    "disciplines": [
      "本集不得用于调整提示词或规则；调参只能看开发集。",
      "expected 只标注必须正确的字段，不惩罚合理的不同表达。",
      "本轮为首次评测；若样本有改动，旧结果作废并重跑。"
    ],
    "note": "首轮 20 条之外按维度补至 50 条：时间边界（6）、地点组合与别名（5）、必去与排除（4）、停留表达（5）、节奏与方式（5）、复合与否定（4）。含 3 条高难度样本（双重排除、二选一、否定嵌套），用于观察边界而不是凑分数。",
    "dimensions": {
      "时间边界": 6,
      "地点组合与别名": 5,
      "必去与排除": 4,
      "停留表达": 5,
      "节奏与出行方式": 5,
      "复合与否定": 4,
      "首轮基础": 20
    }
  },

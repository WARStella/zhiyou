.media-panel { margin-top: 22rpx; }
.media-chooser { padding: 22rpx 26rpx 16rpx; border: 1rpx solid #dbe7f4; border-radius: 24rpx; background: linear-gradient(145deg, #fff, #f2f8ff); box-shadow: 0 4rpx 12rpx rgba(27,70,115,.035); }
.media-heading { font-size: 28rpx; font-weight: 650; color: #152b46; margin-bottom: 20rpx; }
.media-actions { display: flex; gap: 14rpx; }
.media-create.media-create { display: flex; align-items: center; justify-content: center; flex: 1; width: auto; min-width: 0; min-height: 76rpx; line-height: 1.4; padding: 10rpx 8rpx; margin: 0; border-radius: 16rpx; font-size: 26rpx; font-weight: 600; color: #153350; background: linear-gradient(145deg, #e2f3ff, #bfe5ff); }
.media-action-icon { width: 39rpx; height: 39rpx; margin-right: 10rpx; flex: none; }
.media-create::after, .media-query::after, .media-preferences::after { border: none; }
.media-caption { color: #5c6a80; font-size: 23rpx; line-height: 1.6; margin-top: 10rpx; }.media-cost { text-align: center; margin-top: 18rpx; }
.media-result { margin-top: 18rpx; padding: 18rpx; border: 1rpx solid #dce6f3; border-radius: 24rpx; background: rgba(255,255,255,.88); overflow: hidden; box-shadow: 0 4rpx 12rpx rgba(27,70,115,.035); }
.media-result-header { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 12rpx; }.media-result-identity { display: flex; align-items: center; gap: 12rpx; }.media-result-icon { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #e9f4ff; }.media-result-art { width: 34rpx; height: 34rpx; }
.media-result-title { font-size: 27rpx; font-weight: 650; color: #152b46; }.media-badge { padding: 3rpx 12rpx; border-radius: 999rpx; font-size: 21rpx; line-height: 1.55; flex: none; }.media-success { color: #26882b; background: #e9f9eb; }.media-waiting { color: #986515; background: #fff3ce; }.media-failed { color: #647287; background: #f1f5fa; }
.media-generated { display: block; width: 100%; border-radius: 16rpx; }.media-video { display: block; width: 100%; height: 300rpx; border-radius: 16rpx; }.media-credit { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; color: #5a6d87; font-size: 20rpx; line-height: 1.6; margin-top: 10rpx; }
.media-progress { display: flex; align-items: flex-start; gap: 20rpx; padding: 10rpx 6rpx 14rpx; color: #233b57; font-size: 24rpx; line-height: 1.5; }.media-spinner { flex: none; width: 34rpx; height: 34rpx; margin-top: 3rpx; border: 5rpx dotted #259dff; border-radius: 50%; animation: media-turn 1.1s linear infinite; }
@keyframes media-turn { to { transform: rotate(360deg); } }
.media-result-query { display: flex; align-items: center; justify-content: center; min-height: 58rpx; padding: 0 16rpx; border: 1rpx solid #d0dfef; border-radius: 999rpx; color: #223c5d; font-size: 23rpx; background: #f8fbff; }
.media-footer { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 14rpx; }.media-query.media-query { width: auto; margin: 0; padding: 8rpx 18rpx; min-height: 64rpx; color: #17324e; background: #eff6fd; border-radius: 16rpx; font-size: 24rpx; }.media-preferences.media-preferences { width: auto; min-height: 64rpx; display: flex; align-items: center; margin: 0; padding: 8rpx 0; font-size: 23rpx; color: #277fd0; background: transparent; }
.media-error { padding: 16rpx; border-radius: 16rpx; margin-top: 16rpx; color: #8a6a1e; background: #fff5db; font-size: 24rpx; line-height: 1.7; }

.media-create.media-create-primary { flex: 1.35; border: 1rpx solid #98d0fa; background: linear-gradient(180deg, #c4e7ff, #89ceff); color: #123c63; }

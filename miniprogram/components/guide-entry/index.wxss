/* White surface and blue sparkle match the approved assistant identity.
   Keep the 56px hit area in sync with utils/guide-entry.js for dragging. */
:host { position: static; }
.guide-fab {
  position: fixed;
  z-index: 100;
  width: 56px;
  height: 56px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #d5e5f6;
  border-radius: 50%;
  background-color: #fff;
  background-image: url("data:image/png;base64,");
  background-position: center;
  background-size: 34px 34px;
  background-repeat: no-repeat;
  box-shadow: 0 3px 12px rgba(50, 107, 163, .14);
}
/* Use the existing blue asset through WXSS; retain the original WXML. */
.guide-fab-icon { width: 34px; height: 34px; opacity: 0; pointer-events: none; }
.guide-fab-halo {
  position: absolute;
  left: -6px;
  top: -6px;
  right: -6px;
  bottom: -6px;
  border: 1px solid rgba(72, 163, 244, .4);
  border-radius: 50%;
  background: rgba(124, 196, 255, .06);
  pointer-events: none;
  animation: guide-breathe 3s ease-in-out infinite;
}
@keyframes guide-breathe {
  0%, 100% { transform: scale(.96); opacity: .25; }
  50% { transform: scale(1.07); opacity: .75; }
}
.guide-fab-dragging .guide-fab-halo { animation: none; opacity: .2; }
.guide-fab-dragging { background-color: #eef7ff; border-color: #b4d6f5; box-shadow: 0 5px 14px rgba(50, 107, 163, .2); }
.guide-fab-hint {
  position: absolute;
  left: 50%;
  bottom: 64px;
  transform: translateX(-50%);
  padding: 6px 12px;
  border: 1px solid #d5e5f6;
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 3px 10px rgba(50, 107, 163, .1);
  color: #173653;
  font-size: 12px;
  line-height: 1.4;
  white-space: nowrap;
  pointer-events: none;
}

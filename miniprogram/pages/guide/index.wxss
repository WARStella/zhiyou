page { background: #f4f7fb; }
.chat-page { display: flex; flex-direction: column; overflow: hidden; background: #f7f9fc; box-sizing: border-box; color: var(--ink-900); }
.chat-header { display: flex; flex: none; align-items: center; justify-content: space-between; padding: 20rpx 28rpx; border-bottom: 1rpx solid var(--line); background: var(--surface); }
.chat-identity { display: flex; gap: 16rpx; align-items: center; }
.assistant-symbol, .message-avatar { display: flex; flex: none; align-items: center; justify-content: center; color: #fff; background: var(--brand-600); border-radius: 18rpx; }
.assistant-symbol { width: 64rpx; height: 64rpx; font-size: 34rpx; }
.header-title { font-size: 29rpx; font-weight: 600; }
.header-scope { color: var(--ink-500); font-size: 22rpx; margin-top: 5rpx; }
.new-chat.new-chat { width: auto; padding: 0 22rpx; margin: 0; min-height: 68rpx; display: flex; align-items: center; background: var(--surface-2); color: var(--brand-600); font-size: 25rpx; border-radius: 999rpx; }
.new-chat::after, .tool-btn::after, .send-circle::after { border: none; }
.chat-scroll { flex: 1; height: 0; min-height: 0; width: 100%; }
.chat-content { padding: 28rpx 24rpx 8rpx; }
.welcome { padding: 62rpx 16rpx 32rpx; }
.welcome-symbol { color: var(--brand-600); font-size: 68rpx; margin-bottom: 24rpx; }
.welcome-title { font-size: 38rpx; font-weight: 600; letter-spacing: 1rpx; }
.welcome-desc { font-size: 28rpx; color: var(--ink-500); line-height: 1.8; margin-top: 18rpx; }
.starter-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 42rpx; }
.starter { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 24rpx; min-height: 46rpx; background: var(--surface); border: 1rpx solid var(--line); border-radius: 22rpx; font-size: 27rpx; color: var(--ink-700); }
.starter text { color: var(--brand-500); }
.welcome-note { font-size: 23rpx; line-height: 1.7; color: var(--ink-500); margin-top: 28rpx; }
.message { display: flex; align-items: flex-start; gap: 12rpx; margin-bottom: 32rpx; }
.message-main { flex: 1; min-width: 0; }
.message-avatar { width: 46rpx; height: 46rpx; font-size: 27rpx; border-radius: 14rpx; }
.message-label { color: var(--ink-500); font-size: 23rpx; line-height: 42rpx; margin-bottom: 10rpx; }
.bubble { padding: 24rpx; border-radius: 6rpx 24rpx 24rpx; background: #fff; border: 1rpx solid var(--line); }
.message-user { justify-content: flex-end; }
.message-user .message-main { flex: initial; max-width: 88%; }
.message-user .bubble { background: #e4eef9; border-color: #dce7f4; border-radius: 24rpx 6rpx 24rpx 24rpx; }
.message-text { font-size: 29rpx; line-height: 1.85; white-space: pre-wrap; word-break: break-word; }
.message-photo { width: 360rpx; max-width: 100%; border-radius: 14rpx; display: block; margin-bottom: 14rpx; }
.pending { display: flex; align-items: center; gap: 14rpx; font-size: 26rpx; line-height: 1.8; color: var(--ink-500); }
.busy-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--brand-500); animation: busy-pulse 1.4s ease-in-out infinite; }
@keyframes busy-pulse { 0%,100% { opacity: .3; } 50% { opacity: 1; } }
.bubble-error { border-color: var(--danger-line); }
.hint { color: var(--ink-500); font-size: 24rpx; line-height: 1.7; margin-top: 10rpx; }
.notice { color: var(--ink-500); font-size: 23rpx; line-height: 1.7; margin-top: 14rpx; }
.error, .composer-error { color: var(--danger); font-size: 24rpx; line-height: 1.7; padding: 12rpx; background: var(--danger-bg); border-radius: 12rpx; }
.candidate, .source { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid var(--line); }
.place-name { font-size: 28rpx; font-weight: 600; line-height: 1.6; color: var(--ink-900); }
.actions { display: flex; gap: 12rpx; flex-wrap: wrap; margin-top: 12rpx; }
.actions button { margin: 0; font-size: 25rpx; }
.primary-action, .send { background: var(--brand-100); color: var(--brand-700); }
.send { margin-top: 18rpx; border-radius: 16rpx; font-size: 26rpx; }
.card { margin-top: 20rpx; margin-bottom: 0; border-radius: 18rpx; padding: 20rpx; box-shadow: none; background: var(--surface-2); }
.change-question { margin-top: 20rpx; font-size: 26rpx; line-height: 1.7; }
.change-choice { display: inline-flex; align-items: center; min-height: 72rpx; box-sizing: border-box; padding: 12rpx 18rpx; margin: 10rpx 10rpx 0 0; border: 1rpx solid var(--line-strong); border-radius: 14rpx; font-size: 25rpx; }
.change-selected { color: #fff; background: var(--brand-600); }
.change-input { margin-top: 12rpx; padding: 16rpx; border: 1rpx solid var(--line-strong); border-radius: 12rpx; background: #fff; font-size: 27rpx; }
.source-panel { margin-top: 20rpx; border-top: 1rpx solid var(--line); }
.source-toggle, .link { display: flex; align-items: center; min-height: 72rpx; color: var(--brand-600); font-size: 24rpx; }
.source-title { font-size: 24rpx; line-height: 1.6; }
.crowd-preview { position: relative; margin-top: 16rpx; }
.crowd-photo { display: block; width: 100%; }
.crowd-box { position: absolute; border: 2px solid var(--detection); box-sizing: border-box; pointer-events: none; }
.conversation-end { height: 16rpx; }
.composer { flex: none; background: #fff; border-top: 1rpx solid var(--line); padding: 16rpx 24rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.input-shell { background: #f5f7fa; border: 1rpx solid var(--line-strong); border-radius: 26rpx; padding: 18rpx 18rpx 12rpx; }
.question { width: 100%; box-sizing: border-box; min-height: 58rpx; max-height: 180rpx; font-size: 28rpx; line-height: 1.6; padding: 4rpx 6rpx 12rpx; }
.compose-bar { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.compose-tools { display: flex; align-items: center; gap: 8rpx; }
.tool-btn.tool-btn { width: auto; min-width: 68rpx; min-height: 68rpx; padding: 0 14rpx; margin: 0; display: flex; align-items: center; justify-content: center; background: transparent; color: var(--ink-500); border-radius: 14rpx; font-size: 25rpx; line-height: 1.4; }
.tool-active.tool-active { color: var(--brand-600); background: var(--brand-100); }
.send-circle.send-circle { width: 72rpx; height: 72rpx; min-height: 72rpx; flex: none; padding: 0; margin: 0; display: flex; justify-content: center; align-items: center; border-radius: 50%; color: #fff; background: var(--brand-600); font-size: 35rpx; line-height: 1; }
.send-circle.button-disabled, .send-circle:disabled { background: var(--line-strong); color: var(--ink-400); }
.tool-btn.button-disabled, .tool-btn:disabled { color: var(--ink-300); }
.composer-note { text-align: center; color: var(--ink-500); font-size: 21rpx; line-height: 1.5; margin-top: 12rpx; }
.attachment { display: flex; align-items: center; gap: 16rpx; padding: 0 4rpx 16rpx; }
.attachment-photo { width: 88rpx; height: 88rpx; border-radius: 14rpx; }
.attachment-info { flex: 1; font-size: 25rpx; }
.attachment-info .hint { margin-top: 2rpx; font-size: 22rpx; }
.remove-photo { min-width: 72rpx; min-height: 72rpx; text-align: center; line-height: 72rpx; font-size: 35rpx; color: var(--ink-500); }
.more-actions, .voice-panel { padding: 8rpx 4rpx 20rpx; }
.tool-action.tool-action { width: auto; margin: 0; }
.composer-error { margin-bottom: 12rpx; }



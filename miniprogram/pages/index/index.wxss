.page {
  padding: 28rpx 24rpx 60rpx;
}

.hd {
  padding: 8rpx 4rpx 24rpx;
}
.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #0b3c6e;
}
.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7b8794;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(11, 60, 110, 0.06);
}
.card.bad {
  border-left: 8rpx solid #e5484d;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.row2 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.k {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2933;
}
.v {
  font-size: 26rpx;
  font-weight: 600;
}
.ok {
  color: #0f9d58;
}
.bad {
  color: #e5484d;
}

.kv {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f0f2f4;
}
.k2 {
  font-size: 26rpx;
  color: #7b8794;
}
.v2 {
  font-size: 26rpx;
  color: #1f2933;
}

.err {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #e5484d;
  word-break: break-all;
}

/* 「下一步」诊断区：把难懂的错误码翻译成可执行动作 */
.diag {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: #fff8ed;
  border-left: 8rpx solid #f5a623;
  border-radius: 8rpx;
}
.diag-hd {
  font-size: 24rpx;
  font-weight: 600;
  color: #b26a00;
  margin-bottom: 8rpx;
}
.diag .hint {
  color: #6b5a3e;
  margin-top: 0;
}
.hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #7b8794;
  white-space: pre-wrap;
}

.btn {
  margin: 0 0 20rpx;
  background: #0b3c6e;
  color: #fff;
  font-size: 30rpx;
  border-radius: 12rpx;
}
.btn[disabled] {
  background: #9aa5b1;
  color: #fff;
}

/* 次按钮：与主操作区分，避免误点"初始化数据库" */
.btn.ghost {
  background: #fff;
  color: #0b3c6e;
  border: 2rpx solid #0b3c6e;
}
.btn.ghost[disabled] {
  color: #9aa5b1;
  border-color: #cfd6dd;
  background: #fff;
}

.btns {
  margin-bottom: 8rpx;
}
.link-btn {
  margin-top: 4rpx;
  background: #eef3f9;
  color: #0b3c6e;
  font-size: 26rpx;
  border-radius: 12rpx;
}
.tip {
  text-align: center;
  font-size: 22rpx;
  color: #9aa5b1;
  margin-bottom: 20rpx;
}
.running {
  text-align: center;
  font-size: 24rpx;
  color: #0b6bcb;
  padding: 16rpx 0 20rpx;
}

.link {
  font-size: 26rpx;
  color: #0b6bcb;
}
.time {
  font-size: 22rpx;
  color: #9aa5b1;
}

.json {
  display: block;
  margin-top: 16rpx;
  padding: 20rpx;
  background: #0f1620;
  color: #b8e0c8;
  font-family: Consolas, Monaco, monospace;
  font-size: 20rpx;
  line-height: 1.6;
  border-radius: 10rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.foot {
  text-align: center;
  font-size: 22rpx;
  color: #9aa5b1;
  padding: 20rpx 0;
}

.page {
  padding: 28rpx 24rpx 60rpx;
}

.hd {
  padding: 8rpx 4rpx 24rpx;
}
.title {
  font-size: var(--fs-display);
  font-weight: 600;
  color: var(--brand-600);
}


.card.bad {
  border-left: 8rpx solid var(--danger);
}

.row2 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}


.ok {
  color: var(--success);
}
.bad {
  color: var(--danger);
}

.kv {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.k2 {
  font-size: var(--fs-body);
  color: var(--ink-500);
}
.v2 {
  font-size: var(--fs-body);
  color: var(--ink-900);
}

.err {
  margin-top: 12rpx;
  font-size: var(--fs-sm);
  line-height: 1.6;
  color: var(--danger);
  word-break: break-all;
}

/* 「下一步」诊断区：把难懂的错误码翻译成可执行动作 */
.diag {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: var(--warn-bg);
  border-left: 8rpx solid var(--warn);
  border-radius: var(--r-sm);
}
.diag-hd {
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--warn);
  margin-bottom: 8rpx;
}
.diag .hint {
  color: var(--warn);
  margin-top: 0;
}
.hint {
  margin-top: 12rpx;
  font-size: var(--fs-sm);
  line-height: 1.7;
  color: var(--ink-500);
  white-space: pre-wrap;
}
/*
 * 禁用态的按钮样式。
 *
 * ⚠️ 原写法是 `.btn[disabled]` —— **WXSS 不支持属性选择器**，
 * 所以这条规则**从未生效过**（禁用的按钮一直是正常态的外观，
 * 用户看不出"这个按钮现在不能点"）。编译器的警告说的就是这件事：
 *   「Some selectors are not allowed in component wxss,
 *     including tag name selectors, ID selectors, and attribute selectors」
 *
 * 微信给禁用的 `<button>` 加的是**类名**（`button-disabled`），不是属性。
 * 这里两种都写上：`:disabled` 是标准伪类，即使类名在小程序某个版本里
 * 变了也还能兜住 —— 这种"两条腿"的写法在本项目里用过多次
 * （见 `lib/map/tencent.js` 的 `keyStatus()`），代价只是多一行。
 */
/* 次按钮：与主操作区分，避免误点"初始化数据库" */

.btns {
  margin-bottom: 8rpx;
}
.link-btn {
  margin-top: 4rpx;
  background: var(--brand-100);
  color: var(--brand-600);
  font-size: var(--fs-body);
  border-radius: var(--r-sm);
}
.tip {
  text-align: center;
  font-size: var(--fs-xs);
  color: var(--ink-300);
  margin-bottom: 20rpx;
}
.running {
  text-align: center;
  font-size: var(--fs-sm);
  color: var(--brand-600);
  padding: 16rpx 0 20rpx;
}

.link {
  font-size: var(--fs-body);
  color: var(--brand-600);
}
.time {
  font-size: var(--fs-xs);
  color: var(--ink-300);
}

.json {
  display: block;
  margin-top: 16rpx;
  padding: 20rpx;
  background: var(--code-bg);
  color: var(--code-ink);
  font-family: Consolas, Monaco, monospace;
  font-size: var(--fs-xs);
  line-height: 1.6;
  border-radius: var(--r-sm);
  white-space: pre-wrap;
  word-break: break-all;
}

.foot {
  text-align: center;
  font-size: var(--fs-xs);
  color: var(--ink-300);
  padding: 20rpx 0;
}

page { background: #f3f6fa; color: #20334a; }
.page { padding: 28rpx; padding-bottom: 80rpx; }
.title { font-size: 44rpx; font-weight: 700; margin-bottom: 12rpx; }
.intro, .hint { font-size: 25rpx; line-height: 1.7; color: #63758a; }
.card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-top: 24rpx; font-size: 27rpx; line-height: 1.7; overflow: hidden; }
.heading { font-size: 31rpx; font-weight: 700; margin-bottom: 18rpx; }
input { background: #f1f5fa; padding: 18rpx; border-radius: 10rpx; margin: 16rpx 0; font-size: 26rpx; }
button { margin: 16rpx 0; background: #0b3c6e; color: white; font-size: 28rpx; }
button.secondary { background: #edf2f8; color: #294c72; }
.error { margin-top: 20rpx; padding: 20rpx; border-radius: 12rpx; background: #fff0ed; color: #a52c24; word-break: break-all; }
.mono, .json { display: block; font-family: monospace; word-break: break-all; font-size: 23rpx; }
.json { white-space: pre-wrap; background: #f6f8fb; padding: 14rpx; }
.member { border-bottom: 1rpx solid #e4eaf2; padding: 14rpx 0; word-break: break-all; }
.status { font-weight: 700; color: #0b6955; margin: 12rpx 0; }

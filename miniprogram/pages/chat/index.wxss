page { background: transparent; color: var(--ink-900); }
.page { padding: 24rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.intro { font-size: var(--fs-body); color: var(--ink-500); line-height: 1.6; margin-bottom: 16rpx; }
.messages { height: 48vh; border-radius: var(--r-md); background: var(--surface-2); }
.message { padding: 18rpx 20rpx; display: flex; flex-direction: column; align-items: flex-start; }
.mine { align-items: flex-end; }
.meta { color: var(--ink-400); font-size: var(--fs-sm); margin-bottom: 8rpx; }
.bubble { max-width: 85%; padding: 18rpx 22rpx; background: var(--surface); border-radius: var(--r-md); font-size: var(--fs-body); line-height: 1.55; white-space: pre-wrap; word-break: break-all; }
.mine .bubble { background: var(--brand-100); }
.empty { padding: 70rpx 20rpx; color: var(--ink-400); text-align: center; font-size: var(--fs-body); }
.history, .new-messages { display: block; margin: 14rpx auto; color: var(--brand-600); background: var(--surface); font-size: var(--fs-body); }
.composer { padding: 20rpx; background: var(--surface); border-radius: var(--r-md); margin-top: 18rpx; }
textarea { box-sizing: border-box; width: 100%; height: 150rpx; background: var(--surface-2); border-radius: var(--r-sm); padding: 16rpx; font-size: var(--fs-body); }
.send-row { display: flex; justify-content: space-between; align-items: center; margin-top: 18rpx; }
.count { color: var(--ink-500); font-size: var(--fs-sm); }
.send { margin: 0; background: var(--brand-600); color: var(--surface); }
.error, .sync-error { color: var(--danger); font-size: var(--fs-body); line-height: 1.5; padding: 12rpx 0; }
.sync-error text { color: var(--brand-600); margin-left: 12rpx; }

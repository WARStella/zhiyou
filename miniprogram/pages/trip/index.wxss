.page {
  /* 底部留出 tabBar 的高度，否则页面最后的按钮会被它盖住 */
  padding: 24rpx 24rpx 200rpx;
}

/* ── 提示条 ───────────────────────────────── */
.warn {
  background: #fff8ed;
  border-left: 8rpx solid #f5a623;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #8a5a00;
}
.err {
  background: #fdecec;
  border-left: 8rpx solid #e5484d;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #b02a2e;
}
.note {
  font-size: 23rpx;
  color: #0b6bcb;
  padding: 4rpx 0 16rpx;
}

/* ── 卡片 ─────────────────────────────────── */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(11, 60, 110, 0.06);
}
.card.bad {
  border-left: 8rpx solid #e5484d;
}
.row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.k {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2933;
}
.v {
  font-size: 26rpx;
  font-weight: 600;
}
.v.link {
  color: #0b6bcb;
}
.v.muted {
  color: #9aa5b1;
  font-weight: 400;
}
.ok {
  color: #0f9d58;
}
.bad {
  color: #e5484d;
}
.sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #7b8794;
}
.hint {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #7b8794;
}
.conflict {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #b02a2e;
}

/* ── 地点选择 ─────────────────────────────── */
.place {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f4;
}
.place:last-child {
  border-bottom: none;
}
.place-left {
  display: flex;
  align-items: center;
}
.order {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #eef1f4;
  color: #b0b8c1;
  font-size: 22rpx;
  margin-right: 16rpx;
}
.order.on {
  background: #0b3c6e;
  color: #fff;
}
.place-text {
  display: flex;
  flex-direction: column;
}
.place-name {
  font-size: 27rpx;
  color: #1f2933;
}
.place-meta {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #9aa5b1;
}
.check {
  font-size: 30rpx;
  color: #0f9d58;
}
.place.on .place-name {
  font-weight: 600;
  color: #0b3c6e;
}

/* ── 按钮 ─────────────────────────────────── */
.btn {
  margin: 0 0 20rpx;
  background: #0b3c6e;
  color: #fff;
  font-size: 29rpx;
  border-radius: 12rpx;
}
/*
 * 禁用态。⚠️ 原写法 `.btn[disabled]` 是**属性选择器**，WXSS 不支持 ——
 * 规则从未生效（禁用按钮一直是正常态外观）。编译器的警告说的就是这个。
 * 微信给禁用的 button 加的是**类名** `button-disabled`，所以按类名写。
 */
.btn.button-disabled,
.btn:disabled {
  background: #9aa5b1;
  color: #fff;
}
.btn.ghost {
  background: #fff;
  color: #0b3c6e;
  border: 2rpx solid #0b3c6e;
}
.btn.ghost.button-disabled,
.btn.ghost:disabled {
  color: #9aa5b1;
  border-color: #cfd6dd;
}
.btn.small {
  margin-top: 20rpx;
  font-size: 26rpx;
  padding: 6rpx 0;
}

/* ── 概览 ─────────────────────────────────── */
.summary .sum-row {
  display: flex;
  justify-content: space-between;
  margin: 22rpx 0 6rpx;
}
.sum-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.sum-v {
  font-size: 32rpx;
  font-weight: 600;
  color: #0b3c6e;
}
.sum-k {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9aa5b1;
}

/* ── 时间轴 ───────────────────────────────── */
.tl {
  margin-bottom: 10rpx;
}
.node {
  display: flex;
  padding-bottom: 8rpx;
}
.node-rail {
  width: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 30rpx;
}
.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #cfd6dd;
  flex: none;
}
.node.current .dot {
  width: 24rpx;
  height: 24rpx;
  background: #ff7a45;
}
.node.done .dot {
  background: #0f9d58;
}
.node.skipped .dot {
  background: #e5484d;
}
.line {
  width: 3rpx;
  flex: 1;
  background: #e6eaee;
  margin-top: 6rpx;
}
.node-body {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(11, 60, 110, 0.06);
}
.node.current .node-body {
  border-left: 8rpx solid #ff7a45;
}
.node-head {
  display: flex;
  align-items: center;
}
.node-seq {
  font-size: 22rpx;
  color: #9aa5b1;
  margin-right: 12rpx;
}
.node-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #1f2933;
  flex: 1;
}
.badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  background: #eef1f4;
  color: #7b8794;
}
.badge.done {
  background: #e8f5ee;
  color: #0f9d58;
}
.badge.arrived {
  background: #fff1e8;
  color: #d9642a;
}
.badge.skipped {
  background: #fdecec;
  color: #e5484d;
}
.node-times {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}
.t {
  font-size: 23rpx;
  color: #52606d;
  margin-right: 22rpx;
}
.node-travel {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #0fa98a;
}

/* ── 出行段：两个目的地之间 ─────────────────── */
.leg {
  display: flex;
  align-items: stretch;
  margin: -8rpx 0 8rpx;
}
.leg-rail {
  width: 40rpx;
  display: flex;
  justify-content: center;
  flex: none;
}
.leg-bar {
  width: 3rpx;
  background: #cfd6dd;
  border-radius: 2rpx;
}
.leg-body {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  padding: 12rpx 20rpx;
  margin-left: 0;
  background: #f4f7fa;
  border-radius: 10rpx;
  flex: 1;
}
.leg-mode {
  font-size: 23rpx;
  font-weight: 600;
  color: #0b3c6e;
  margin-right: 10rpx;
}
.leg-time {
  font-size: 23rpx;
  font-weight: 600;
  color: #0fa98a;
  margin-right: 10rpx;
}
.leg-dist {
  font-size: 21rpx;
  color: #7b8794;
}
.leg-warn {
  font-size: 20rpx;
  color: #d9642a;
  background: #fff1e8;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
}
/* 估算出来的时间要能一眼看出来 —— 它与真实路线在短距离下能差 7 倍 */
.leg-estimated .leg-body {
  background: #fff8ed;
}

/* 已走过的路段：变绿，与地图上的绿线一致 */
.leg-visited .leg-bar {
  background: #0f9d58;
}
.leg-visited .leg-body {
  background: #eef8f2;
}
.leg-visited .leg-time {
  color: #0f9d58;
}
.leg-done {
  font-size: 20rpx;
  color: #0f9d58;
  border: 2rpx solid #0f9d58;
  border-radius: 6rpx;
  padding: 1rpx 10rpx;
  margin-left: 10rpx;
}

/* ── 已到过的节点 ─────────────────────────── */.node.visited .dot {
  background: #0f9d58;
  width: 22rpx;
  height: 22rpx;
}
.node.visited .node-body {
  border-left: 8rpx solid #0f9d58;
}
.node.visited .node-name {
  color: #0f9d58;
}

/* ── 跳过的节点 ───────────────────────────── */
/* ⚠️ 跳过的**不能显示成绿色** —— 绿色代表"去过了"，跳过就是没去。
   灰色才如实：这一站被跳过了。 */
.node.skip .dot {
  background: #9aa5b1;
}
.node.skip .node-body {
  border-left: 8rpx solid #9aa5b1;
  opacity: 0.72;
}
.node.skip .node-name {
  color: #9aa5b1;
  text-decoration: line-through;
}

/* ── 进度操作 ─────────────────────────────── */
.progress-acts {
  border-top: none;
  padding-top: 12rpx;
}
.progress-act {
  color: #0f9d58;
  font-weight: 600;
}
.acts {
  display: flex;
  margin-top: 18rpx;
  border-top: 1rpx solid #f0f2f4;
  padding-top: 16rpx;
}
.act {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #0b6bcb;
}
.act.warn-act {
  color: #d9642a;
}

/* ── 候选卡片 ─────────────────────────────── */
.cand-head {
  padding: 20rpx 24rpx;
}
.cand-label {
  font-size: 29rpx;
  font-weight: 600;
  color: #0b3c6e;
}
.card.cand.infeasible {
  opacity: 0.72;
  border-left: 8rpx solid #e5484d;
}
.cand-metrics {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.m {
  font-size: 22rpx;
  color: #52606d;
  background: #f4f6f8;
  border-radius: 6rpx;
  padding: 6rpx 14rpx;
  margin: 0 12rpx 10rpx 0;
}
.changes {
  margin-top: 14rpx;
}
.changes-hd {
  font-size: 22rpx;
  color: #9aa5b1;
  margin-bottom: 8rpx;
}
.change {
  font-size: 23rpx;
  line-height: 1.7;
  color: #1f2933;
}
.quality-warn {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #d9642a;
}
.conflicts {
  margin-top: 12rpx;
}

.foot {
  text-align: center;
  font-size: 21rpx;
  line-height: 1.6;
  color: #b0b8c1;
  padding: 24rpx 10rpx 40rpx;
}

/* ── 搜索行 ───────────────────────────────── */
.search-row {
  display: flex;
  align-items: center;
}
.search-input {
  flex: 1;
  height: 72rpx;
  background: #f4f6f8;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #1f2933;
}
.search-btn {
  margin-left: 16rpx;
  padding: 0 30rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #0b3c6e;
  color: #fff;
  font-size: 26rpx;
  border-radius: 10rpx;
}
.mt {
  margin-top: 22rpx;
}
.row-right {
  display: flex;
  align-items: center;
}
.clear {
  margin-left: 18rpx;
  font-size: 22rpx;
  color: #9aa5b1;
}

/* ── 候选项 ───────────────────────────────── */
.tick {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 8rpx;
  border: 2rpx solid #cfd6dd;
  color: #fff;
  font-size: 24rpx;
  margin-right: 18rpx;
  flex: none;
}
.tick.on {
  background: #0f9d58;
  border-color: #0f9d58;
}

/* ── 已选顺序 ─────────────────────────────── */
.sel {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f2f4;
}
/* 名称 + 预选理由两行 —— 理由用弱化样式，不抢名字的注意力 */
.sel-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.sel-reason {
  font-size: 22rpx;
  color: #9aa5b1;
  margin-top: 4rpx;
}
.sel:last-child {
  border-bottom: none;
}
.sel-seq {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #0b3c6e;
  color: #fff;
  font-size: 22rpx;
  margin-right: 16rpx;
  flex: none;
}
.sel-name {
  flex: 1;
  font-size: 27rpx;
  color: #1f2933;
}
.sel-del {
  font-size: 23rpx;
  color: #d9642a;
  padding: 6rpx 12rpx;
}

/* ── 提醒卡 ───────────────────────────────── */
.warncard {
  background: #fff8ed;
  border-left: 8rpx solid #f5a623;
}
.warn-item {
  font-size: 23rpx;
  line-height: 1.7;
  color: #8a5a00;
}

/* ── 意图解析 ─────────────────────────────── */
.intent {
  margin-top: 18rpx;
  background: #f7f9fb;
  border-radius: 10rpx;
  padding: 18rpx;
}
.intent-hd {
  font-size: 25rpx;
  font-weight: 600;
  color: #0b3c6e;
}
.degraded {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  /* 中性色：没配模型不是故障，别用警告色吓人 */
  color: #7b8794;
}
.uncertain {
  margin-top: 16rpx;
  border-top: 1rpx solid #e6eaee;
  padding-top: 14rpx;
}
.uncertain-hd {
  font-size: 22rpx;
  color: #d9642a;
  margin-bottom: 8rpx;
}
.uncertain-item {
  font-size: 22rpx;
  line-height: 1.6;
  color: #52606d;
  margin-bottom: 10rpx;
}
.cands {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}
.cand {
  font-size: 22rpx;
  color: #0b6bcb;
  border: 2rpx solid #0b6bcb;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  margin: 0 12rpx 8rpx 0;
}
.from-parse {
  font-size: 20rpx;
  color: #0f9d58;
  background: #e8f5ee;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 10rpx;
}

/* ── 出发段 ───────────────────────────────── */
.start-leg {
  border-left: 8rpx solid #ff7a45;
}
.leg-line {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #0fa98a;
}

/* ── 路线地图 ─────────────────────────────── */
.map-card {
  padding: 16rpx 16rpx 20rpx;
}
.route-map {
  width: 100%;
  height: 420rpx;
  border-radius: 12rpx;
}

/* ── 步行来源 ─────────────────────────────── */
.src-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}
.src {
  font-size: 22rpx;
  border-radius: 6rpx;
  padding: 6rpx 14rpx;
  margin: 0 12rpx 8rpx 0;
}
.src.good {
  background: #e8f5ee;
  color: #0f9d58;
}
.src.bad {
  background: #fff1e8;
  color: #d9642a;
}
.travel-warn {
  color: #d9642a;
  margin-left: 8rpx;
}
.badge.unverified {
  background: #f4f6f8;
  color: #9aa5b1;
  margin-right: 8rpx;
}



/* ── 进度（概览卡片顶部）───────────────────── */
/* 游玩时最常看的信息，放在最上面，不必去地图卡片上找 */
.progress-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 12rpx 0 4rpx;
}
.progress-main {
  font-size: 28rpx;
  font-weight: 600;
  color: #0b3c6e;
}
.progress-next {
  font-size: 24rpx;
  color: #9aa5b1;
}
.progress-done {
  font-size: 22rpx;
  color: #0f9d58;
  border: 2rpx solid #0f9d58;
  border-radius: 6rpx;
  padding: 1rpx 10rpx;
}

/* ── 出发段（时间轴里的第一段）───────────────── */
/* 与站点之间的出行段同一套样式 —— 它们本来就是同一类东西 */
.leg-start .leg-body {
  background: #eef4fb;
}
.leg-from,
.leg-to {
  font-size: 22rpx;
  color: #6b7785;
  margin-right: 8rpx;
}

/* ── 当前路线（这一段怎么走）───────────────── */
/*
  这块**不是**"站的顺序"，而是"这一段怎么走、多远、多久"。
  顺序是计划，出行方式与距离才是行走时真正要看的东西。
  也是将来接导航的落点。
*/
.leg-headline {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  padding: 10rpx 0 4rpx;
}
.leg-from-name {
  font-size: 28rpx;
  color: #6b7785;
}
.leg-to-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #0b3c6e;
}
.leg-arrow {
  font-size: 26rpx;
  color: #c3cad3;
  margin: 0 14rpx;
}
.leg-figures {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 6rpx 0 2rpx;
}
.fig-mode {
  font-size: 24rpx;
  color: #0b3c6e;
  background: #eef4fb;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}
.fig-strong {
  font-size: 32rpx;
  font-weight: 600;
  color: #0b3c6e;
}
.fig {
  font-size: 26rpx;
  color: #6b7785;
}
.leg-actions {
  padding: 12rpx 0 0;
}
.btn.small {
  font-size: 26rpx;
  padding: 12rpx 0;
  margin: 0;
}

/* ── 内置导航：转向指引 ───────────────────── */
/*
  指令文案**一律用上游原话**（腾讯返回的 instruction），不自己拼 ——
  编错一个路口，用户就多走一公里。
*/
.nav-steps {
  margin-top: 16rpx;
  border-top: 1rpx solid #f0f2f4;
  padding-top: 16rpx;
}
.nav-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 10rpx;
}
.nav-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #0b3c6e;
}
.nav-step {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f7f8f9;
}
.nav-step:last-child {
  border-bottom: none;
}
.nav-seq {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #0b3c6e;
  color: #ffffff;
  font-size: 22rpx;
  margin-right: 14rpx;
}
.nav-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.nav-text {
  font-size: 26rpx;
  color: #2c3540;
  line-height: 1.5;
}
.nav-dist {
  font-size: 22rpx;
  color: #9aa5b1;
  margin-top: 4rpx;
}

/* ── 出行方式与来源（2026-10-14）──────────────────────────
   接入多种出行方式后新增。**"怎么走"与"这个数可不可信"要能分开看** ——
   后者是"直线估算"时必须显眼，它与真实路线在短距离下能差 7 倍。 */
.leg-src {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: #7b8794;
}
.leg-transit {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #0b3c6e;
}
.leg-reason {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #9aa5b1;
}
/* 当前路线卡片上的多行说明（2026-10-14）
   公交换乘细节与"为什么没有方案"都放在这里，比挤在 figures 那一行更清楚。 */
.leg-reason-line{font-size:22rpx;color:#9aa5b1;margin-top:6rpx}
.leg-transit-line{font-size:23rpx;color:#0b3c6e;margin-top:6rpx}
/* 没按用户选的出行方式 —— 必须显眼（2026-10-14）。
   用户选了步行却被改成驾车，如果和普通说明一个样式，他会以为系统没理他。 */
.leg-reason-miss {
  color: #b26a00;
  background: #fff7e6;
  border-radius: 8rpx;
  padding: 6rpx 10rpx;
}
/* ── 逐段出行方式选择（2026-10-14 用户要求）────────────────
   每段一行，行内是各方式的耗时；系统推荐的那个带"推荐"小字样。 */
.leg-picker { padding-bottom: 12rpx; }
.lp-head { cursor: pointer; }
.lp-head-hover { background: #f3f6fa; border-radius: 10rpx; }
.lp-leg { padding: 14rpx 0; border-top: 1rpx solid #edf1f6; }
.lp-leg-head { display: flex; align-items: center; margin-bottom: 10rpx; }
.lp-seq {
  width: 34rpx; height: 34rpx; line-height: 34rpx; text-align: center;
  border-radius: 50%; background: #e8f0f8; color: #0b3c6e;
  font-size: 20rpx; margin-right: 10rpx;
}
.lp-path { font-size: 25rpx; color: #20334a; }
.lp-opts { display: flex; flex-wrap: wrap; }
.lp-opt {
  display: flex; align-items: center; flex-wrap: wrap;
  padding: 10rpx 16rpx; margin: 0 12rpx 12rpx 0;
  border: 1rpx solid #d9e5ef; border-radius: 12rpx;
  background: #fbfdff;
}
/* 选中的那个要一眼看出来 */
.lp-opt-on { border-color: #0b3c6e; background: #eef4fb; }
.lp-opt-name { font-size: 24rpx; color: #20334a; margin-right: 8rpx; }
.lp-opt-min { font-size: 22rpx; color: #65758a; }
/* "推荐"小字样 —— 系统的判断（最快），不受用户偏好影响 */
.lp-badge {
  margin-left: 8rpx; padding: 0 8rpx;
  font-size: 18rpx; color: #b26a00; background: #fff2d8;
  border-radius: 6rpx;
}
.lp-opt-sub { width: 100%; font-size: 19rpx; color: #7b8794; margin-top: 4rpx; }
.lp-unavail { font-size: 20rpx; color: #9aa5b1; }
.lp-actions { display: flex; margin-top: 12rpx; }
/* 选择器没内容时的说明（2026-10-14）
   卡片不再静默消失，所以要能说清"为什么这里没东西"。 */
.lp-empty { font-size: 22rpx; color: #9aa5b1; padding: 10rpx 0; line-height: 1.7; }
.lp-strong { color: #b26a00; font-weight: 600; }

/* 点站名看地图 —— 给一点按压反馈，否则点了没动静会以为没生效 */
.node-head-hover {
  background: #f3f6fa;
  border-radius: 10rpx;
}
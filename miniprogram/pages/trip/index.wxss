.page {
  /* 底部留出 tabBar 的高度，否则页面最后的按钮会被它盖住 */
  padding: 24rpx 24rpx 200rpx;
}

/* ── 提示条 ───────────────────────────────── */
.warn {
  background: #fff8ed;
  border-left: 8rpx solid #f5a623;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #8a5a00;
}
.err {
  background: #fdecec;
  border-left: 8rpx solid #e5484d;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #b02a2e;
}
.note {
  font-size: 23rpx;
  color: #0b6bcb;
  padding: 4rpx 0 16rpx;
}

/* ── 卡片 ─────────────────────────────────── */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(11, 60, 110, 0.06);
}
.card.bad {
  border-left: 8rpx solid #e5484d;
}
.row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.k {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2933;
}
.v {
  font-size: 26rpx;
  font-weight: 600;
}
.v.link {
  color: #0b6bcb;
}
.v.muted {
  color: #9aa5b1;
  font-weight: 400;
}
.ok {
  color: #0f9d58;
}
.bad {
  color: #e5484d;
}
.sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #7b8794;
}
.hint {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #7b8794;
}
.conflict {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #b02a2e;
}

/* ── 地点选择 ─────────────────────────────── */
.place {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f4;
}
.place:last-child {
  border-bottom: none;
}
.place-left {
  display: flex;
  align-items: center;
}
.order {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #eef1f4;
  color: #b0b8c1;
  font-size: 22rpx;
  margin-right: 16rpx;
}
.order.on {
  background: #0b3c6e;
  color: #fff;
}
.place-text {
  display: flex;
  flex-direction: column;
}
.place-name {
  font-size: 27rpx;
  color: #1f2933;
}
.place-meta {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #9aa5b1;
}
.check {
  font-size: 30rpx;
  color: #0f9d58;
}
.place.on .place-name {
  font-weight: 600;
  color: #0b3c6e;
}

/* ── 按钮 ─────────────────────────────────── */
.btn {
  margin: 0 0 20rpx;
  background: #0b3c6e;
  color: #fff;
  font-size: 29rpx;
  border-radius: 12rpx;
}
.btn[disabled] {
  background: #9aa5b1;
  color: #fff;
}
.btn.ghost {
  background: #fff;
  color: #0b3c6e;
  border: 2rpx solid #0b3c6e;
}
.btn.ghost[disabled] {
  color: #9aa5b1;
  border-color: #cfd6dd;
}
.btn.small {
  margin-top: 20rpx;
  font-size: 26rpx;
  padding: 6rpx 0;
}

/* ── 概览 ─────────────────────────────────── */
.summary .sum-row {
  display: flex;
  justify-content: space-between;
  margin: 22rpx 0 6rpx;
}
.sum-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.sum-v {
  font-size: 32rpx;
  font-weight: 600;
  color: #0b3c6e;
}
.sum-k {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9aa5b1;
}

/* ── 时间轴 ───────────────────────────────── */
.tl {
  margin-bottom: 10rpx;
}
.node {
  display: flex;
  padding-bottom: 8rpx;
}
.node-rail {
  width: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 30rpx;
}
.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #cfd6dd;
  flex: none;
}
.node.current .dot {
  width: 24rpx;
  height: 24rpx;
  background: #ff7a45;
}
.node.done .dot {
  background: #0f9d58;
}
.node.skipped .dot {
  background: #e5484d;
}
.line {
  width: 3rpx;
  flex: 1;
  background: #e6eaee;
  margin-top: 6rpx;
}
.node-body {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(11, 60, 110, 0.06);
}
.node.current .node-body {
  border-left: 8rpx solid #ff7a45;
}
.node-head {
  display: flex;
  align-items: center;
}
.node-seq {
  font-size: 22rpx;
  color: #9aa5b1;
  margin-right: 12rpx;
}
.node-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #1f2933;
  flex: 1;
}
.badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  background: #eef1f4;
  color: #7b8794;
}
.badge.done {
  background: #e8f5ee;
  color: #0f9d58;
}
.badge.arrived {
  background: #fff1e8;
  color: #d9642a;
}
.badge.skipped {
  background: #fdecec;
  color: #e5484d;
}
.node-times {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}
.t {
  font-size: 23rpx;
  color: #52606d;
  margin-right: 22rpx;
}
.node-travel {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #0fa98a;
}

/* ── 出行段：两个目的地之间 ─────────────────── */
.leg {
  display: flex;
  align-items: stretch;
  margin: -8rpx 0 8rpx;
}
.leg-rail {
  width: 40rpx;
  display: flex;
  justify-content: center;
  flex: none;
}
.leg-bar {
  width: 3rpx;
  background: #cfd6dd;
  border-radius: 2rpx;
}
.leg-body {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  padding: 12rpx 20rpx;
  margin-left: 0;
  background: #f4f7fa;
  border-radius: 10rpx;
  flex: 1;
}
.leg-mode {
  font-size: 23rpx;
  font-weight: 600;
  color: #0b3c6e;
  margin-right: 10rpx;
}
.leg-time {
  font-size: 23rpx;
  font-weight: 600;
  color: #0fa98a;
  margin-right: 10rpx;
}
.leg-dist {
  font-size: 21rpx;
  color: #7b8794;
}
.leg-warn {
  font-size: 20rpx;
  color: #d9642a;
  background: #fff1e8;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
}
/* 估算出来的时间要能一眼看出来 —— 它与真实路线在短距离下能差 7 倍 */
.leg-estimated .leg-body {
  background: #fff8ed;
}

/* 已走过的路段：变绿，与地图上的绿线一致 */
.leg-visited .leg-bar {
  background: #0f9d58;
}
.leg-visited .leg-body {
  background: #eef8f2;
}
.leg-visited .leg-time {
  color: #0f9d58;
}
.leg-done {
  font-size: 20rpx;
  color: #0f9d58;
  border: 2rpx solid #0f9d58;
  border-radius: 6rpx;
  padding: 1rpx 10rpx;
  margin-left: 10rpx;
}

/* ── 已到过的节点 ─────────────────────────── */
.node.visited .dot {
  background: #0f9d58;
  width: 22rpx;
  height: 22rpx;
}
.node.visited .node-body {
  border-left: 8rpx solid #0f9d58;
}
.node.visited .node-name {
  color: #0f9d58;
}

/* ── 跳过的节点 ───────────────────────────── */
/* ⚠️ 跳过的**不能显示成绿色** —— 绿色代表"去过了"，跳过就是没去。
   灰色才如实：这一站被跳过了。 */
.node.skip .dot {
  background: #9aa5b1;
}
.node.skip .node-body {
  border-left: 8rpx solid #9aa5b1;
  opacity: 0.72;
}
.node.skip .node-name {
  color: #9aa5b1;
  text-decoration: line-through;
}

/* ── 进度操作 ─────────────────────────────── */
.progress-acts {
  border-top: none;
  padding-top: 12rpx;
}
.progress-act {
  color: #0f9d58;
  font-weight: 600;
}
.acts {
  display: flex;
  margin-top: 18rpx;
  border-top: 1rpx solid #f0f2f4;
  padding-top: 16rpx;
}
.act {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #0b6bcb;
}
.act.warn-act {
  color: #d9642a;
}

/* ── 候选卡片 ─────────────────────────────── */
.cand-head {
  padding: 20rpx 24rpx;
}
.cand-label {
  font-size: 29rpx;
  font-weight: 600;
  color: #0b3c6e;
}
.card.cand.infeasible {
  opacity: 0.72;
  border-left: 8rpx solid #e5484d;
}
.cand-metrics {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.m {
  font-size: 22rpx;
  color: #52606d;
  background: #f4f6f8;
  border-radius: 6rpx;
  padding: 6rpx 14rpx;
  margin: 0 12rpx 10rpx 0;
}
.changes {
  margin-top: 14rpx;
}
.changes-hd {
  font-size: 22rpx;
  color: #9aa5b1;
  margin-bottom: 8rpx;
}
.change {
  font-size: 23rpx;
  line-height: 1.7;
  color: #1f2933;
}
.quality-warn {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #d9642a;
}
.conflicts {
  margin-top: 12rpx;
}

.foot {
  text-align: center;
  font-size: 21rpx;
  line-height: 1.6;
  color: #b0b8c1;
  padding: 24rpx 10rpx 40rpx;
}

/* ── 搜索行 ───────────────────────────────── */
.search-row {
  display: flex;
  align-items: center;
}
.search-input {
  flex: 1;
  height: 72rpx;
  background: #f4f6f8;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #1f2933;
}
.search-btn {
  margin-left: 16rpx;
  padding: 0 30rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #0b3c6e;
  color: #fff;
  font-size: 26rpx;
  border-radius: 10rpx;
}
.mt {
  margin-top: 22rpx;
}
.row-right {
  display: flex;
  align-items: center;
}
.clear {
  margin-left: 18rpx;
  font-size: 22rpx;
  color: #9aa5b1;
}

/* ── 候选项 ───────────────────────────────── */
.tick {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 8rpx;
  border: 2rpx solid #cfd6dd;
  color: #fff;
  font-size: 24rpx;
  margin-right: 18rpx;
  flex: none;
}
.tick.on {
  background: #0f9d58;
  border-color: #0f9d58;
}

/* ── 已选顺序 ─────────────────────────────── */
.sel {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f2f4;
}
/* 名称 + 预选理由两行 —— 理由用弱化样式，不抢名字的注意力 */
.sel-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.sel-reason {
  font-size: 22rpx;
  color: #9aa5b1;
  margin-top: 4rpx;
}
.sel:last-child {
  border-bottom: none;
}
.sel-seq {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #0b3c6e;
  color: #fff;
  font-size: 22rpx;
  margin-right: 16rpx;
  flex: none;
}
.sel-name {
  flex: 1;
  font-size: 27rpx;
  color: #1f2933;
}
.sel-del {
  font-size: 23rpx;
  color: #d9642a;
  padding: 6rpx 12rpx;
}

/* ── 提醒卡 ───────────────────────────────── */
.warncard {
  background: #fff8ed;
  border-left: 8rpx solid #f5a623;
}
.warn-item {
  font-size: 23rpx;
  line-height: 1.7;
  color: #8a5a00;
}

/* ── 意图解析 ─────────────────────────────── */
.intent {
  margin-top: 18rpx;
  background: #f7f9fb;
  border-radius: 10rpx;
  padding: 18rpx;
}
.intent-hd {
  font-size: 25rpx;
  font-weight: 600;
  color: #0b3c6e;
}
.degraded {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  /* 中性色：没配模型不是故障，别用警告色吓人 */
  color: #7b8794;
}
.uncertain {
  margin-top: 16rpx;
  border-top: 1rpx solid #e6eaee;
  padding-top: 14rpx;
}
.uncertain-hd {
  font-size: 22rpx;
  color: #d9642a;
  margin-bottom: 8rpx;
}
.uncertain-item {
  font-size: 22rpx;
  line-height: 1.6;
  color: #52606d;
  margin-bottom: 10rpx;
}
.cands {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}
.cand {
  font-size: 22rpx;
  color: #0b6bcb;
  border: 2rpx solid #0b6bcb;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  margin: 0 12rpx 8rpx 0;
}
.from-parse {
  font-size: 20rpx;
  color: #0f9d58;
  background: #e8f5ee;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 10rpx;
}

/* ── 出发段 ───────────────────────────────── */
.start-leg {
  border-left: 8rpx solid #ff7a45;
}
.leg-line {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #0fa98a;
}

/* ── 路线地图 ─────────────────────────────── */
.map-card {
  padding: 16rpx 16rpx 20rpx;
}
.route-map {
  width: 100%;
  height: 420rpx;
  border-radius: 12rpx;
}

/* ── 步行来源 ─────────────────────────────── */
.src-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}
.src {
  font-size: 22rpx;
  border-radius: 6rpx;
  padding: 6rpx 14rpx;
  margin: 0 12rpx 8rpx 0;
}
.src.good {
  background: #e8f5ee;
  color: #0f9d58;
}
.src.bad {
  background: #fff1e8;
  color: #d9642a;
}
.travel-warn {
  color: #d9642a;
  margin-left: 8rpx;
}
.badge.unverified {
  background: #f4f6f8;
  color: #9aa5b1;
  margin-right: 8rpx;
}



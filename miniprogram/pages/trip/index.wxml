<view class="page">
  <team-panel personal-trip-id="{{trip.tripId}}" />

  <!-- 含未核验地点时必须显著提示：说明它能做什么、不能做什么 -->
  <view wx:if="{{unverifiedNotice}}" class="warn">
    ⚠️ 本次路线含 {{unverifiedNotice.count}} 个**未核验**地点。
    可以安排进游览顺序，但**不能作为集合点** —— 集合点要求实地核验（入口位置、可达性、辨识度）。
  </view>

  <view wx:if="{{error}}" class="err">{{error}}</view>
  <view wx:if="{{note}}" class="note">{{note}}</view>

  <!-- ══════════ 未生成路线：需求输入 + 候选选择 ══════════ -->
  <block wx:if="{{!trip}}">

    <!-- 需求输入：一句话，而不是一个个搜地点 -->
    <view class="card">
      <view class="search-row">
        <input
          class="search-input"
          placeholder="说一句话，例如：我下午想去中央大街附近逛逛，五点前结束"
          value="{{keyword}}"
          confirm-type="search"
          bindinput="onKeyword"
          bindconfirm="doSearch"
        />
        <view class="search-btn" bindtap="doSearch">{{loading ? '…' : '理解'}}</view>
      </view>

      <!-- 系统理解成了什么 —— 依据与来源全部摊开，不藏 -->
      <view wx:if="{{intent}}" class="intent">
        <view class="row">
          <text class="intent-hd">我理解到的</text>
          <text class="v muted">{{intent.parserLabel}}</text>
        </view>

        <view wx:if="{{intent.degradationNote}}" class="degraded">{{intent.degradationNote}}</view>

        <view wx:if="{{!intent.explanation.length}}" class="hint">没有能确定的项</view>
        <view wx:for="{{intent.explanation}}" wx:key="*this" class="change">· {{item}}</view>

        <!-- §6.2：含糊表达不自动换算，给选项让用户定 -->
        <view wx:if="{{intent.uncertainties.length}}" class="uncertain">
          <view class="uncertain-hd">需要你确认（系统不替你决定）</view>
          <view wx:for="{{intent.uncertainties}}" wx:key="why" class="uncertain-item">
            <text>· {{item.why}}</text>
            <view wx:if="{{item.candidates}}" class="cands">
              <text
                wx:for="{{item.candidates}}"
                wx:for-item="c"
                wx:key="*this"
                class="cand"
                data-field="{{item.field}}"
                data-value="{{c}}"
                bindtap="pickUncertainty"
              >选 {{c}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="row mt">
        <text class="k">出发时间</text>
        <picker mode="time" value="{{startAtText}}" bindchange="onStartTimeChange">
          <text class="v link">{{startAtText}} ›</text>
        </picker>
      </view>

      <view class="row">
        <text class="k">结束时间</text>
        <view class="row-right">
          <picker wx:if="{{!endAtText}}" mode="time" value="18:00" bindchange="onEndTimeChange">
            <text class="v link">不限 ›</text>
          </picker>
          <block wx:else>
            <text wx:if="{{endAtFromParse}}" class="from-parse">解析</text>
            <picker mode="time" value="{{endAtText}}" bindchange="onEndTimeChange">
              <text class="v link">{{endAtText}} ›</text>
            </picker>
            <text class="clear" bindtap="clearEndAt">清除</text>
          </block>
        </view>
      </view>
      <view class="sub">设了结束时间就是**硬约束**：系统宁可告诉你做不到，也不会默默超时</view>

      <view class="row">
        <text class="k">每站停留</text>
        <view class="row-right">
          <text wx:if="{{stayMin}}" class="from-parse">解析</text>
          <text class="v link">{{stayMin ? stayMin + ' 分钟' : '地点默认'}}</text>
        </view>
      </view>
      <view class="sub">说「逛一小时」会填在这里；不填就用地点自带的建议停留时间</view>

      <view class="row">
        <text class="k">按真实步行时间排序</text>
        <switch checked="{{enrichWalk}}" bindchange="onEnrichChange" />
      </view>
      <view class="sub">开启后每次搜索会多消耗若干次地图配额，换来"哪些地方现在去最方便"的准确顺序</view>

      <!--
        出行方式 —— 用户自己选（2026-10-14 用户要求）。
        **是偏好不是强制**：选的方式走不通时会给出可行方案，
        并说清为什么没按你选的来（那句话会显示在出行段上）。
      -->
      <view class="row">
        <text class="k">出行方式</text>
        <picker mode="selector" range="{{modeOptions}}" range-key="label" value="{{modeIndex}}" bindchange="onModeChange">
          <view class="v link">{{modeOptions[modeIndex].label}}</view>
        </picker>
      </view>
      <view class="sub">{{modeHint}}</view>
    </view>

    <!-- 规划被判定不可行：如实展示冲突，并指向可调整的条件 -->
    <view wx:if="{{planRejected}}" class="card bad">
      <view class="row"><text class="k">当前条件下无法生成路线</text></view>
      <view wx:for="{{conflicts}}" wx:key="*this" class="conflict">· {{item}}</view>
      <view class="hint">
        请调整地点选择、出发时间，或放宽结束时间要求。
        **系统不会替你放宽自己设定的硬约束。**
      </view>
    </view>

    <!-- 候选地点 -->
    <view class="card">
      <view class="row">
        <text class="k">{{mode === 'search' ? '搜索结果' : '已知地点'}}</text>
        <text class="v muted">{{candidates.length}} 个</text>
      </view>
      <view wx:if="{{rankingNote}}" class="hint">{{rankingNote}}</view>

      <view wx:if="{{loading && !candidates.length}}" class="hint">正在加载…</view>
      <view wx:if="{{!loading && !candidates.length}}" class="hint">
        没有可选地点。可以搜索外部地点，或等待实地核验的地点录入。
      </view>

      <view
        wx:for="{{candidates}}"
        wx:key="itemId"
        class="place {{item.selected ? 'on' : ''}}"
        data-id="{{item.itemId}}"
        bindtap="toggleCandidate"
      >
        <view class="place-left">
          <view class="tick {{item.selected ? 'on' : ''}}">{{item.selected ? '✓' : ''}}</view>
          <view class="place-text">
            <text class="place-name">{{item.name}}</text>
            <text class="place-meta">
              {{item.category}}{{item.verified ? '' : ' · 未核验（可游览·不可集合）'}}
              <block wx:if="{{item.distanceText}}"> · {{item.distanceText}}</block>
              <block wx:if="{{item.durationText}}"> · {{item.durationText}}</block>
            </text>
          </view>
        </view>
      </view>
    </view>

    <!-- 已选（勾选顺序即游览顺序） -->
    <view wx:if="{{selected.length}}" class="card">
      <view class="row">
        <text class="k">游览顺序</text>
        <text class="v muted">勾选顺序即顺序</text>
      </view>
      <view wx:for="{{selected}}" wx:key="itemId" class="sel">
        <text class="sel-seq">{{index + 1}}</text>
        <view class="sel-body">
          <text class="sel-name">{{item.name}}</text>
          <!--
            预选理由 —— 用户一眼能看出"为什么是它"。
            系统替他选了地方，就必须说清依据（不藏依据是这个项目的一贯要求）。
          -->
          <text wx:if="{{item.reason}}" class="sel-reason">{{item.reason}}</text>
        </view>
        <text class="sel-del" data-id="{{item.itemId}}" bindtap="removeSelected">移除</text>
      </view>
    </view>

    <button class="btn" bindtap="createTrip" disabled="{{loading || !selected.length}}">
      {{loading ? '处理中…' : '生成路线（' + selected.length + ' 个地点）'}}
    </button>
  </block>

  <!-- ══════════ 已生成：时间轴（§5.1） ══════════ -->
  <block wx:else>

    <view class="card summary">
      <view class="row">
        <text class="k">路线概览</text>
        <text class="v muted">版本 v{{trip.version}}</text>
      </view>
      <!--
        进度放在最上面 —— "当前走到哪了"是游玩时最常看的信息，
        「已走过 X / Y 站」在这里也更新一份，不必去地图卡片上找。
      -->
      <view wx:if="{{routeMap}}" class="progress-row">
        <text class="progress-main">已走过 {{routeMap.reachedCount}} / {{routeMap.totalCount}} 站</text>
        <!--
          ⚠️ 这里**不做比较运算**：`>=` 与 `&gt;=` 在 WXML 里都不该用。
          `&gt;` 不会被解码成 `>`，编译器会直接报 ``unexpected '&'``；
          写原始 `>` 只是依赖解析器的容忍度。判断已在 JS 里算成 routeMap.allReached。
          （2026-10-14：我一度把它"修"成 &gt;=，结果把能编译的页面改到编译不过。）
        -->
        <text wx:if="{{routeMap.allReached}}" class="progress-done">全部走完</text>
        <text wx:elif="{{routeMap.nextName}}" class="progress-next">下一站：{{routeMap.nextName}}</text>
      </view>
      <view class="sum-row">
        <view class="sum-item"><text class="sum-v">{{summary.nodeCount}}</text><text class="sum-k">个节点</text></view>
        <view class="sum-item"><text class="sum-v">{{summary.totalWalkMin}}</text><text class="sum-k">分钟步行</text></view>
        <view class="sum-item"><text class="sum-v">{{summary.totalStayMin}}</text><text class="sum-k">分钟停留</text></view>
        <view class="sum-item"><text class="sum-v">{{summary.endAt}}</text><text class="sum-k">预计结束</text></view>
      </view>
      <button class="btn ghost" bindtap="resetTrip">重新选择地点</button>
    </view>

    <!--
      ══════════ 逐段出行方式（2026-10-14 用户要求）══════════════

      "点击生成路径后出现界面，让用户分别选择每段路径的出行方式"，
      并在推荐的方式边上打"推荐"字样。

      **默认收起**：路线已生成、决策已完成，这个面板是"想调整时才用"的，
      展开着会把地图挤走（与小队面板同一个考虑）。
    -->
    <view wx:if="{{legPicker.length}}" class="card leg-picker">
      <view class="row lp-head" bindtap="toggleLegPicker" hover-class="lp-head-hover">
        <text class="k">出行方式 · 逐段调整</text>
        <text class="v muted">{{legPickerOpen ? '收起 ▴' : '展开 ▾'}}</text>
      </view>

      <view wx:if="{{!legPickerOpen}}" class="sub">
        各段已按最快自动选好。想自己定某一段，点「展开」。
      </view>

      <block wx:if="{{legPickerOpen}}">
        <view wx:for="{{legPicker}}" wx:key="toPlaceId" class="lp-leg">
          <view class="lp-leg-head">
            <text class="lp-seq">{{item.index}}</text>
            <text class="lp-path">{{item.fromName}} → {{item.toName}}</text>
          </view>

          <view class="lp-opts">
            <view
              wx:for="{{item.options}}"
              wx:for-item="opt"
              wx:key="mode"
              class="lp-opt {{opt.isCurrent ? 'lp-opt-on' : ''}}"
              data-placeid="{{item.toPlaceId}}"
              data-mode="{{opt.mode}}"
              bindtap="onLegModeTap"
            >
              <text class="lp-opt-name">{{opt.icon}} {{opt.name}}</text>
              <text class="lp-opt-min">{{opt.minutes}} 分钟</text>
              <!--
                "推荐"字样 —— 这是**系统自己的判断**（最快），
                不受用户偏好影响。否则用户选了什么就推荐什么，标签毫无信息量。
              -->
              <text wx:if="{{opt.recommended}}" class="lp-badge">推荐</text>
              <!-- 公交换乘细节，让用户能据以比较 -->
              <text wx:if="{{opt.transitText}}" class="lp-opt-sub">{{opt.transitText}}</text>
            </view>
          </view>

          <!-- 这一段取不到的方式：要说清为什么不能选，而不是消失 -->
          <view wx:if="{{item.unavailable.length}}" class="lp-unavail">
            <text wx:for="{{item.unavailable}}" wx:for-item="u" wx:key="mode">
              {{u.modeLabel}}：{{u.reason}}
            </text>
          </view>
        </view>

        <view class="lp-actions">
          <button class="btn small" bindtap="applyLegModes">应用这些选择</button>
          <button class="btn ghost small" bindtap="resetLegModes">恢复推荐</button>
        </view>
        <view class="sub">应用后会重排到达时间；候选耗时已在生成时取到，不会额外消耗地图配额。</view>
      </block>
    </view>

    <!--
      出发段的卡片版已删 —— 它挪进时间轴了（见下方 .tl 的第一段）。
      独立卡片放在概览与地图之间，离时间轴太远，读起来不像"第一站之前那一段"，
      而站点之间是画在时间轴里的，两处不一致。
    -->

    <!--
      当前路线 = **这一段怎么走**（出行方式 + 距离 + 时长），不是"站的顺序"。
      顺序是计划，出行方式与距离才是行走时真正要看的东西。
      也是将来接导航的落点 —— 点「导航」交给微信内置地图。
    -->
    <view wx:if="{{currentLeg}}" class="card route-card">
      <view class="row">
        <text class="k">当前路线</text>
        <text class="v muted">第 {{currentLeg.legIndex}} / {{currentLeg.totalLegs}} 段</text>
      </view>
      <view class="leg-headline">
        <text class="leg-from-name">{{currentLeg.from}}</text>
        <text class="leg-arrow">→</text>
        <text class="leg-to-name">{{currentLeg.to}}</text>
      </view>
      <view class="leg-figures">
        <text wx:if="{{currentLeg.mode}}" class="fig-mode">{{currentLeg.modeIcon}} {{currentLeg.mode}}</text>
        <!--
          ⚠️ `wx:if="{{currentLeg.minutes}}"` 对 `null` 是安全的（不渲染），
          但**必须有一条"没取到方案"的说明** —— 否则这一段的时长会静默消失，
          看起来像界面坏了。远距离又取不到公交/驾车时就是这种情况。
        -->
        <text wx:if="{{currentLeg.minutes}}" class="fig-strong">{{currentLeg.minutes}} 分钟</text>
        <text wx:if="{{currentLeg.meters}}" class="fig">{{currentLeg.meters}} 米</text>
        <text wx:if="{{currentLeg.sourceLabel}}" class="leg-src">{{currentLeg.sourceLabel}}</text>
        <text wx:if="{{currentLeg.estimated}}" class="leg-warn">估算</text>
        <text wx:if="{{!currentLeg.minutes}}" class="leg-warn">没取到出行方案</text>
      </view>
      <!-- 为什么没有方案 —— 说清原因，别让人以为界面坏了 -->
      <view wx:if="{{currentLeg.reason}}" class="leg-reason-line">{{currentLeg.reason}}</view>
      <!-- 公交换乘细节：几号线、1 号口进 3 号口出 -->
      <view wx:if="{{currentLeg.transitText}}" class="leg-transit-line">{{currentLeg.transitText}}</view>
      <view class="leg-actions">
        <button wx:if="{{!navLeg}}" class="btn small" bindtap="startNavigation" disabled="{{navLoading}}">
          {{navLoading ? '正在取路线…' : '开始导航'}}
        </button>
        <block wx:else>
          <button class="btn ghost small" bindtap="stopNavigation">退出导航</button>
        </block>
        <button class="btn ghost small" bindtap="openInWechatMap">用微信地图打开（有语音）</button>
      </view>

      <view wx:if="{{navError}}" class="hint">{{navError}}</view>
      <view wx:if="{{navHint}}" class="hint">{{navHint}}</view>

      <!-- 内置导航：转向指引（**上游原话**，不自己做文案） -->
      <view wx:if="{{navLeg && navLeg.steps.length}}" class="nav-steps">
        <view class="nav-head">
          <text class="nav-title">转向指引</text>
          <text class="v muted">{{navLeg.distanceMeters}} 米 · {{navLeg.durationMinutes}} 分钟</text>
        </view>
        <view wx:for="{{navLeg.steps}}" wx:key="seq" class="nav-step">
          <text class="nav-seq">{{item.seq}}</text>
          <view class="nav-body">
            <text class="nav-text">{{item.instruction}}</text>
            <text wx:if="{{item.distanceMeters}}" class="nav-dist">{{item.distanceMeters}} 米</text>
          </view>
        </view>
        <view class="sub">路径与指令均来自上游；地图上画的是真实步行路径，不是直线示意</view>
      </view>

      <view class="sub" wx:else>导航交给微信内置地图；应用内逐步导航是后续计划</view>
    </view>

    <!-- 路线地图：走到哪了一眼看得出 -->
    <view wx:if="{{routeMap}}" class="card map-card">
      <view class="row">
        <text class="k">路线地图</text>
        <text class="v muted">已走过 {{routeMap.reachedCount}} / {{routeMap.totalCount}} 站</text>
      </view>
      <map
        id="routeMap"
        class="route-map"
        latitude="{{routeMap.center.latitude}}"
        longitude="{{routeMap.center.longitude}}"
        markers="{{routeMap.markers}}"
        polyline="{{routeMap.polyline}}"
        include-points="{{routeMap.includePoints}}"
        show-location="{{false}}"
      ></map>
      <view class="sub">{{routeMap.legend}}</view>
    </view>

    <!-- 步行时间的来源构成：真实路线与估算必须能区分 -->
    <view wx:if="{{walkTimes}}" class="card">
      <view class="row">
        <text class="k">步行时间来源</text>
        <text class="v muted">地图调用 {{walkTimes.mapApiCalls}} 次</text>
      </view>
      <view class="src-row">
        <text wx:if="{{walkTimes.bySource.survey}}" class="src good">踏勘实测 {{walkTimes.bySource.survey}} 段</text>
        <text wx:if="{{walkTimes.bySource.upstream}}" class="src good">真实路线 {{walkTimes.bySource.upstream}} 段</text>
        <text wx:if="{{walkTimes.bySource.estimated}}" class="src bad">直线估算 {{walkTimes.bySource.estimated}} 段</text>
      </view>
      <view class="hint">{{walkTimes.note}}</view>
      <view wx:if="{{walkTimes.failures.length}}" class="hint">
        <view wx:for="{{walkTimes.failures}}" wx:key="from" class="conflict">
          · {{item.from}} → {{item.to}}：{{item.message || item.reason}}
        </view>
      </view>
    </view>

    <!-- 非阻断性提醒（未核验、时间紧张等） -->
    <view wx:if="{{warnings.length}}" class="card warncard">
      <view wx:for="{{warnings}}" wx:key="code" class="warn-item">· {{item.message}}</view>
    </view>

    <!-- 时间轴：出发段 + 节点与节点之间的出行段，都在这里 -->
    <view class="tl">
      <!--
        出发段：从当前位置到第一站。
        **必须画在时间轴最前面** —— 它与站点之间的出行段是同一类东西，
        分开放会让人以为"第一站之前没有路程"。不给它的话，
        行程还会假装人已经在第一站门口。
      -->
      <view wx:if="{{startLeg}}" class="leg leg-start">
        <view class="leg-rail">
          <view class="leg-bar"></view>
        </view>
        <view class="leg-body">
          <text class="leg-from">{{startLeg.label}}</text>
          <!--
            ⚠️ 这里原来写的是 `<text class="leg-mode">步行</text>` ——
            **写死的文本**。于是时间轴上"我的位置 → 第一站"这一段永远显示步行，
            无论实际坐地铁还是公交（用户实测：12618 米也显示步行）。
            那就是用户看到"步行"的第二个来源。
          -->
          <text class="leg-mode">
            <block wx:if="{{startLeg.modeIcon}}">{{startLeg.modeIcon}} </block>{{startLeg.mode || '步行'}}
          </text>
          <text wx:if="{{startLeg.minutes}}" class="leg-time">{{startLeg.minutes}} 分钟</text>
          <text wx:if="{{!startLeg.minutes}}" class="leg-warn">没取到出行方案</text>
          <text wx:if="{{startLeg.meters}}" class="leg-dist">{{startLeg.meters}} 米</text>
          <text wx:if="{{startLeg.sourceLabel}}" class="leg-src">{{startLeg.sourceLabel}}</text>
          <text wx:if="{{startLeg.warn}}" class="leg-warn">{{startLeg.warn}}</text>
          <text class="leg-to">{{startLeg.toName}}</text>
          <!-- 公交换乘细节：几号线、1 号口进 3 号口出 -->
          <text wx:if="{{startLeg.transitText}}" class="leg-transit">{{startLeg.transitText}}</text>
          <!-- 为什么选它 / 为什么没有方案 -->
          <text wx:if="{{startLeg.reason}}" class="leg-reason">{{startLeg.reason}}</text>
        </view>
      </view>

      <block wx:for="{{timeline}}" wx:key="nodeId">
        <view class="node {{item.isCurrent ? 'current' : ''}} {{item.status}} {{item.visited ? 'visited' : ''}} {{item.skipped ? 'skip' : ''}}">
          <view class="node-rail">
            <view class="dot"></view>
            <view wx:if="{{!item.isLast}}" class="line"></view>
          </view>

          <view class="node-body">
            <view class="node-head">
              <text class="node-seq">{{item.seq}}</text>
              <text class="node-name">{{item.placeName}}</text>
              <text wx:if="{{!item.verified}}" class="badge unverified">未核验</text>
              <text class="badge {{item.status}}">{{item.statusLabel}}</text>
            </view>

            <view class="node-times">
              <text class="t">到达 {{item.arrive}}</text>
              <text class="t">停留 {{item.stayMin}} 分钟</text>
              <text class="t">离开 {{item.leave}}</text>
            </view>

            <!-- 进度：记录实际发生的事，不改路线 -->
            <view class="acts progress-acts">
              <view
                wx:for="{{item.progressActions}}"
                wx:for-item="pa"
                wx:key="status"
                class="act progress-act"
                data-nodeid="{{item.nodeId}}"
                data-status="{{pa.status}}"
                bindtap="nodeProgress"
              >{{pa.label}}</view>
            </view>

            <!-- 调整：改计划，会重算后续 -->
            <view class="acts">
              <view class="act" data-nodeid="{{item.nodeId}}" data-key="extend" bindtap="nodeAction">多停一会儿</view>
              <view class="act" data-nodeid="{{item.nodeId}}" data-key="shorten" bindtap="nodeAction">少停一会儿</view>
              <view class="act warn-act" data-nodeid="{{item.nodeId}}" data-key="skip" bindtap="nodeAction">不去了</view>
            </view>
          </view>
        </view>

        <!--
          出行段：**独立的一条**，位于两个目的地之间。
          放在这里而不是塞进节点卡片里 —— 塞进去会读成"到了这里之后要走 8 分钟"，
          而它的意思是"从上一站走过来要 8 分钟"。
        -->
        <view wx:if="{{item.legToNext}}" class="leg {{item.legToNext.warn ? 'leg-estimated' : ''}} {{item.legToNext.visited ? 'leg-visited' : ''}}">
          <view class="leg-rail">
            <view class="leg-bar"></view>
          </view>
          <view class="leg-body">
            <!--
              出行方式 + 图标。
              ⚠️ 这里必须用 **`modeName`**（中文名），不是 `mode`。
              `mode` 是**原始值**（`driving`/`transit`/…），
              `modeName` 才是给人看的 `驾车`/`公交`。

              我一度渲染成 `mode`，于是界面上出现「🚗 驾车」与
              「🚗 driving」两种写法并存 —— 用户一眼就看出来了。
              原始值只该出现在日志与测试断言里，不该给用户看。
            -->
            <text class="leg-mode">
              <block wx:if="{{item.legToNext.modeIcon}}">{{item.legToNext.modeIcon}} </block>{{item.legToNext.modeName}}
            </text>
            <text wx:if="{{item.legToNext.minutes}}" class="leg-time">{{item.legToNext.minutes}} 分钟</text>
            <text wx:else class="leg-warn">没取到出行方案</text>
            <text class="leg-dist">{{item.legToNext.meters}} 米</text>
            <!--
              来源与方式是两个维度，**都要显示**：
              方式说"怎么走"，来源说"这个数可不可信"。
              直线估算与真实路线在短距离下能差 7 倍，必须能区分。
            -->
            <text wx:if="{{item.legToNext.sourceLabel}}" class="leg-src">{{item.legToNext.sourceLabel}}</text>
            <text wx:if="{{item.legToNext.warn}}" class="leg-warn">{{item.legToNext.warn}}</text>
            <text wx:if="{{item.legToNext.visited}}" class="leg-done">已走过</text>
            <!-- 公交换乘细节：几号线、1 号口进 3 号口出 -->
            <text wx:if="{{item.legToNext.transitText}}" class="leg-transit">{{item.legToNext.transitText}}</text>
            <!--
              为什么选它 —— 只给结论不给理由，用户没法判断该不该接受。
              ⚠️ **没按用户选的来时这句要显眼**（`.leg-reason-miss`）：
              他选了步行却被改成驾车，如果和普通说明一个样式，
              会以为系统没理他。
            -->
            <text
              wx:if="{{item.legToNext.reason}}"
              class="leg-reason {{item.legToNext.matchedPreference === false ? 'leg-reason-miss' : ''}}"
            >{{item.legToNext.reason}}</text>
          </view>
        </view>
      </block>
    </view>

    <!-- ══════════ 调整候选（§5.2 四种展示情况） ══════════ -->
    <block wx:if="{{proposal}}">
      <view class="card cand-head">
        <view class="row">
          <text class="k">调整方案</text>
          <text class="v muted">{{proposalNote}}</text>
        </view>
      </view>

      <!-- 没有可行方案：指出冲突，请用户选择调整哪个条件 -->
      <view wx:if="{{proposalMode === 'none'}}" class="card bad">
        <view class="row"><text class="k">没有可行的调整方案</text></view>
        <view class="hint">冲突所在：</view>
        <view wx:for="{{proposalCandidates}}" wx:key="candidateId">
          <view wx:for="{{item.conflicts}}" wx:for-item="c" wx:key="*this" class="conflict">· {{c}}</view>
        </view>
        <view class="hint">
          请选择要放宽的条件：把出发时间提前、减少一个地点，或放宽结束时间要求。
          **系统不会为了凑出一个方案而放宽你自己设定的硬约束。**
        </view>
      </view>

      <!-- 有可行方案：逐条展示差异与取舍 -->
      <block wx:else>
        <view
          wx:for="{{proposalCandidates}}"
          wx:key="candidateId"
          class="card cand {{item.feasible ? '' : 'infeasible'}}"
        >
          <view class="row">
            <text class="cand-label">{{item.label}}</text>
            <text class="v {{item.feasible ? 'ok' : 'bad'}}">
              {{item.feasible ? '可行' : '不可行'}}
            </text>
          </view>

          <view class="cand-metrics">
            <text class="m">保留 {{item.preserved}} 个节点</text>
            <text class="m">预计结束 {{item.endAt}}</text>
            <text wx:if="{{item.endShiftMin}}" class="m">结束时间变化 {{item.endShiftMin}} 分钟</text>
            <text wx:if="{{item.walkDelta}}" class="m">步行增加 {{item.walkDelta}} 分钟</text>
          </view>

          <view wx:if="{{item.changes.length}}" class="changes">
            <view class="changes-hd">改了什么</view>
            <view wx:for="{{item.changes}}" wx:for-item="c" wx:key="*this" class="change">· {{c}}</view>
          </view>

          <view wx:if="{{!item.qualityOk}}" class="quality-warn">
            ⚠️ 有地点的停留被压到下限以下，该节点不计入"有效保留"
          </view>

          <view wx:if="{{item.conflicts.length}}" class="conflicts">
            <view wx:for="{{item.conflicts}}" wx:for-item="c" wx:key="*this" class="conflict">· {{c}}</view>
          </view>

          <button
            wx:if="{{item.feasible}}"
            class="btn small"
            data-cid="{{item.candidateId}}"
            bindtap="confirmCandidate"
            disabled="{{busy}}"
          >
            {{busy === 'confirm' ? '确认中…' : '选择这个方案'}}
          </button>
        </view>

        <button class="btn ghost" bindtap="discardProposal">保持原计划</button>
      </block>
    </block>

    <view class="foot">
      调整不会自动生效 —— 必须确认后才改写行程（版本 v{{trip.version}}）
    </view>
  </block>
</view>

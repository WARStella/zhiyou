.page {
  padding-bottom: 40rpx;
}

/* 地图：普通流水布局，不被卡片覆盖 —— 直接绕开原生组件层级问题 */
.mapwrap {
  width: 100%;
  height: 56vh;
}
.map {
  width: 100%;
  height: 100%;
}

.body {
  padding: 20rpx 24rpx 0;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(11, 60, 110, 0.06);
}
.card.sel {
  border-left: 8rpx solid #ff7a45;
}

.row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.k {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2933;
}
.v {
  font-size: 26rpx;
  font-weight: 600;
}
.ok {
  color: #0f9d58;
}
.muted {
  color: #9aa5b1;
  font-weight: 400;
}

.sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #7b8794;
}
.note {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #0b6bcb;
}
.hint {
  font-size: 24rpx;
  line-height: 1.7;
  color: #7b8794;
  padding: 10rpx 0;
}
.err {
  font-size: 24rpx;
  color: #e5484d;
  padding: 10rpx 0;
}

.btn {
  margin: 22rpx 0 0;
  background: #0b3c6e;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
}

/* 备用操作：与主操作区分，避免误点 */
.btn.ghost {
  margin-top: 14rpx;
  background: #fff;
  color: #0b3c6e;
  border: 2rpx solid #0b3c6e;
}

/* 候选列表 */
.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f2f4;
}
.item:last-of-type {
  border-bottom: none;
}
.item-main {
  display: flex;
  flex-direction: column;
}
.item-name {
  font-size: 27rpx;
  color: #1f2933;
}
.item-cat {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #9aa5b1;
}
.item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.mins {
  font-size: 27rpx;
  font-weight: 600;
  color: #0b3c6e;
}
.meters {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #9aa5b1;
}

.rule {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0f2f4;
  font-size: 21rpx;
  line-height: 1.6;
  color: #9aa5b1;
}

.foot {
  text-align: center;
  font-size: 21rpx;
  line-height: 1.6;
  color: #b0b8c1;
  padding: 20rpx 10rpx 40rpx;
}

/* ── 照片（2026-10-14）──────────────────────────────────────
   缩略图横向排布，超出一屏时横向滚动 —— 避免照片把卡片撑得很长，
   而集合点卡片下面是地图，用户需要能快速划过这一段。 */
.photos {
  display: flex;
  flex-direction: row;
  margin-top: 14rpx;
  white-space: nowrap;
}
.shot {
  display: flex;
  flex-direction: column;
  margin-right: 16rpx;
  width: 200rpx;
  flex-shrink: 0;
}
.shot-img {
  width: 200rpx;
  height: 150rpx;
  border-radius: 10rpx;
  background: #eef1f4;
}
/* 有 fileID 但取不到临时地址时也会走到这里 —— 明确说"未能保存"而不是留白 */
.shot-img.missing {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  color: #9aa5b1;
}
.shot-title {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #6b7683;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 精度告警（2026-10-14）：精度差时必须显眼 ——
   基于一个偏了几百米的位置算出来的"我要走多久"是没有意义的，
   而这种失真在界面上原本完全看不出来。 */
.note.warn {
  color: #b45309;
  background: #fffbeb;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}

/* 聚焦提示条（2026-10-14）
   从行程页点「到了」跳过来时说明"现在看的是哪一站"，
   否则用户只看到地图突然放大，不知道在看什么。 */
.focus-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #eef4fb;
  border: 1rpx solid #cfe0f2;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 16rpx;
}
.focus-name { font-size: 26rpx; color: #0b3c6e; font-weight: 600; }
.focus-close { font-size: 24rpx; color: #65758a; }
/* ── 地图右下角控件（2026-10-14 用户要求）──────────────────
   把"获取我的位置"与"手动选点"从卡片里的按钮改成地图上的小控件。 */
.mapwrap { position: relative; }

.map-ctl {
  position: absolute;
  right: 24rpx;
  bottom: 48rpx;
  display: flex;
  flex-direction: column;
  z-index: 10;
}
.ctl-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #fff;
  border: 1rpx solid #d9e5ef;
  box-shadow: 0 2rpx 8rpx rgba(11, 60, 110, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
}
.ctl-hover { background: #eef4fb; }
.ctl-icon { font-size: 36rpx; color: #0b3c6e; line-height: 1; }

/* ── 中间图钉（拖动选点）──────────────────────────────────
   ⚠️ `pointer-events: none` 不能少：这一层盖在地图正中，
   若能接收事件就会把地图的拖动与点击全吃掉，"拖动地图"根本做不到。 */
.center-pin {
  position: absolute;
  left: 50%;
  top: 50%;
  /* 让图钉的**尖端**落在正中，而不是图钉中心 —— 差半个图钉高 */
  transform: translate(-50%, -100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
  z-index: 9;
}
.center-pin-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #b24a3f;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
}
.center-pin-stem {
  width: 4rpx;
  height: 34rpx;
  background: #b24a3f;
}

/* 选点模式的提示条：说明"拖地图"而不是"点地图" */
.pick-hint {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(11, 60, 110, 0.92);
  color: #fff;
  font-size: 24rpx;
  border-radius: 12rpx;
  padding: 16rpx 22rpx;
  z-index: 10;
}
.pick-hint-ok {
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 8rpx;
  padding: 4rpx 20rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}
/* ── 队伍卡片（2026-10-14 tab 改名「队伍」）────────────────
   组队之后的事都在这里：位置共享、集合、出发。 */
.acts { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.act {
  padding: 12rpx 22rpx;
  margin: 0 14rpx 12rpx 0;
  border: 1rpx solid #d9e5ef;
  border-radius: 12rpx;
  font-size: 25rpx;
  color: #20334a;
  background: #fbfdff;
}
.act-primary { background: #0b3c6e; color: #fff; border-color: #0b3c6e; }
.meet-setup, .meet-task { margin-top: 16rpx; border-top: 1rpx solid #edf1f6; padding-top: 16rpx; }
.field {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #0b3c6e;
}
.note { font-size: 23rpx; color: #65758a; margin-top: 10rpx; line-height: 1.7; }
.err { font-size: 23rpx; color: #aa3028; background: #fff0ed; padding: 14rpx; border-radius: 10rpx; margin-top: 10rpx; }
.page {
  padding-bottom: 40rpx;
}

/* 地图：普通流水布局，不被卡片覆盖 —— 直接绕开原生组件层级问题 */
.mapwrap {
  width: 100%;
  height: 56vh;
}
.map {
  width: 100%;
  height: 100%;
}

.body {
  padding: 20rpx 24rpx 0;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(11, 60, 110, 0.06);
}
.card.sel {
  border-left: 8rpx solid #ff7a45;
}

.row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.k {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2933;
}
.v {
  font-size: 26rpx;
  font-weight: 600;
}
.ok {
  color: #0f9d58;
}
.muted {
  color: #9aa5b1;
  font-weight: 400;
}

.sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #7b8794;
}
.note {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #0b6bcb;
}
.hint {
  font-size: 24rpx;
  line-height: 1.7;
  color: #7b8794;
  padding: 10rpx 0;
}
.err {
  font-size: 24rpx;
  color: #e5484d;
  padding: 10rpx 0;
}

.btn {
  margin: 22rpx 0 0;
  background: #0b3c6e;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
}

/* 备用操作：与主操作区分，避免误点 */
.btn.ghost {
  margin-top: 14rpx;
  background: #fff;
  color: #0b3c6e;
  border: 2rpx solid #0b3c6e;
}

/* 候选列表 */
.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f2f4;
}
.item:last-of-type {
  border-bottom: none;
}
.item-main {
  display: flex;
  flex-direction: column;
}
.item-name {
  font-size: 27rpx;
  color: #1f2933;
}
.item-cat {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #9aa5b1;
}
.item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.mins {
  font-size: 27rpx;
  font-weight: 600;
  color: #0b3c6e;
}
.meters {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #9aa5b1;
}

.rule {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0f2f4;
  font-size: 21rpx;
  line-height: 1.6;
  color: #9aa5b1;
}

.foot {
  text-align: center;
  font-size: 21rpx;
  line-height: 1.6;
  color: #b0b8c1;
  padding: 20rpx 10rpx 40rpx;
}

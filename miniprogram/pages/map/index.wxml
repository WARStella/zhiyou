<view class="page">

  <view class="mapwrap">
    <map
      id="tripmap"
      class="map"
      longitude="{{center.longitude}}"
      latitude="{{center.latitude}}"
      scale="{{scale}}"
      markers="{{markers}}"
      polyline="{{polyline}}"
      show-location="{{true}}"
      enable-zoom="{{true}}"
      enable-scroll="{{true}}"
      bindtap="onMapTap"
      bindmarkertap="onMarkerTap"
      bindcallouttap="onMarkerTap"
      bindregionchange="onMapRegionChange"
    ></map>

    <!--
      ══════════ 中间图钉（手动选点模式）══════════════════════

      用户要求："手动选点同样改为小控件，但是点击后只需拖动地图即可
      确定图钉的位置，图钉在拖动时保持在屏幕中心不动，
      再次点击控件退出模式时才会随地图拖动一起移动"

      做法：这是一层**固定在容器正中**的覆盖层，地图在它下面滚。
      拖动地图时它不动，看起来就是"图钉钉在屏幕中心、地图在底下滑"。
      退出模式后整层不渲染，位置由 `myPoint` 对应的 marker 表示 ——
      那个 marker 是地图坐标，会随地图一起动。

      ⚠️ 覆盖层必须 `pointer-events: none`（wxss 里写），
      否则它会把地图的拖动与点击都吃掉 —— 那样"拖动地图"根本做不到。
    -->
    <view wx:if="{{pickMode}}" class="center-pin">
      <view class="center-pin-dot"></view>
      <view class="center-pin-stem"></view>
    </view>

    <!--
      ══════════ 右下角小控件 ══════════════════════════════

      用户要求把"获取我的位置"与"手动选点"从卡片里的按钮
      改成**地图右下角的两个小控件**。
    -->
    <view class="map-ctl">
      <view class="ctl-btn" bindtap="startPick" hover-class="ctl-hover">
        <text class="ctl-icon">✛</text>
      </view>
      <view class="ctl-btn" bindtap="useGps" hover-class="ctl-hover">
        <text class="ctl-icon">◎</text>
      </view>
    </view>

    <!-- 选点模式下的一条提示：告诉用户"拖地图"而不是"点地图" -->
    <view wx:if="{{pickMode}}" class="pick-hint">
      <text>拖动地图，把中间图钉对准集合点</text>
      <text class="pick-hint-ok" bindtap="confirmPick">定这里</text>
    </view>
  </view>

  <view class="body">
    <!--
      聚焦提示条（2026-10-14 用户要求）。
      从行程页点「到了」跳过来时，这里说明"现在看的是哪一站"，
      否则用户只看到地图突然放大，不知道在看什么。
    -->
    <view wx:if="{{focusPlace}}" class="focus-bar">
      <text class="focus-name">📍 {{focusPlace.placeName}}</text>
      <text class="focus-close" bindtap="clearFocusPlace">知道了</text>
    </view>

    <!--
      ⚠️⚠️ **本页不再挂 `team-panel`**（2026-10-14 用户要求：
      "在地图页面删掉与同伴一起游览信息卡，然后队伍信息卡在这里只保留集合功能"）。

      为什么这不只是"少一张卡"：那个面板抛的 `teamstate` 事件原本是
      **队员位置与集合点的唯一来源**，所以删它必须同时补上两条数据路径，
      否则地图上就看不到同伴在哪了（而且不报错）：
        · 队员位置 → `refreshTeamLocations()` 调 `loc.list`
        · 集合点   → `loadCrew()` 调 `meet.get` 填 `meetTask`
      两条都已接上，本页现在**不依赖任何组件**。

      ⚠️ **不要把 `team-panel` 加回本页**：
        · 组队与解散在「我的」页（面板的家）
        · 集合相关的操作在本页自己的队伍卡片里
      加回来会出现两处都能发起集合。
    -->

    <view wx:if="{{loading}}" class="hint">正在加载地点数据…</view>
    <view wx:if="{{loadError}}" class="err">地点加载失败：{{loadError}}</view>

    <!--
      ══════════ 队伍（2026-10-14 用户要求）══════════════════

      tab 名已从「地图」改成「队伍」—— 因为组队之后的事（队员位置、
      集合、出发）都在这一页。小队面板那边只管组队与解散。

      没有队伍时不显示这一整块 —— 空卡片会让用户以为页面出了问题。
    -->
    <view wx:if="{{!crewId}}" class="card">
      <view class="row">
        <text class="k">队伍</text>
        <text class="v muted">还没有队伍</text>
      </view>
      <view class="sub">去「我的」页创建小队或输入邀请码加入，之后在这里看队员位置、发起集合。</view>
    </view>

    <view wx:if="{{crewId}}" class="card">
      <view class="row">
        <text class="k">{{crew ? crew.name : '队伍'}}</text>
        <text class="v muted">{{members.length}} 位成员</text>
      </view>

      <!-- 位置共享：主动上报一次，不持续定位 -->
      <view class="acts">
        <view class="act" bindtap="toggleSharing">{{sharing ? '关闭位置共享' : '开启位置共享'}}</view>
        <view class="act" bindtap="reportMyLocation">共享一次当前位置</view>
      </view>
      <view class="sub">
        主动上报一次位置，不持续定位。共享前请先点 ◎ 取位置或拖 ✛ 选点。
      </view>

      <!-- 集合：先推荐，再拖动微调 -->
      <view wx:if="{{!meetTask}}" class="meet-setup">
        <view class="acts">
          <view class="act act-primary" bindtap="recommendMeetingPoint">① 推荐一个集合点</view>
        </view>
        <view class="sub">
          算法让**走得最远的那个成员**尽量近，但它不知道"南门还是北门"这类实地信息 ——
          推荐出来后拖 ✛ 微调，确认无误再发起。
        </view>
        <view class="row">
          <text class="k">集合点名称</text>
          <input class="field" placeholder="如南门指示牌旁" value="{{pointName}}" bindinput="onPointNameInput" maxlength="20"/>
        </view>
        <view class="row">
          <text class="k">集合时间</text>
          <picker mode="time" value="{{meetTime}}" bindchange="onMeetTimeChange">
            <view class="v link">{{meetTime}}</view>
          </picker>
        </view>
        <view class="acts">
          <view class="act act-primary" bindtap="createMeeting">② 发起集合</view>
        </view>
      </view>

      <!-- 进行中的集合 -->
      <view wx:if="{{meetTask}}" class="meet-task">
        <view class="row">
          <text class="k">{{meetTask.placeName || '集合点'}}</text>
          <text class="v muted">{{meetTask.statusLabel || meetTask.status}}</text>
        </view>
        <view class="sub">约定 {{meetTask.timeLabel}} · 到齐 {{meetTask.arrivedLabel}} · 出发 {{meetTask.departedLabel}}</view>
        <view wx:for="{{meetTask.participants}}" wx:key="userId" class="row">
          <text class="k">{{item.label}}</text>
          <text class="v muted">{{item.statusLabel}}</text>
        </view>

        <view class="acts">
          <view wx:if="{{meetTask.status === 'proposed' || meetTask.status === 'confirmed'}}" class="act" data-kind="confirm" bindtap="meetAction">确认集合</view>
          <view wx:if="{{meetTask.status === 'proposed' || meetTask.status === 'confirmed'}}" class="act" data-kind="decline" bindtap="meetAction">暂不参加</view>
          <view wx:if="{{meetTask.status === 'confirmed' || meetTask.status === 'active'}}" class="act" data-kind="arrive" bindtap="meetAction">我已到达</view>
          <view wx:if="{{isOwner}}" class="act" data-kind="cancel" bindtap="meetAction">取消本次集合</view>
        </view>

        <!-- 出发前必须检查后续行程；checkId 是服务端给的凭据 -->
        <view wx:if="{{meetTask.status === 'arrived_all' && isOwner}}">
          <view class="acts">
            <view class="act act-primary" bindtap="prepareDepart">准备出发 · 检查后续行程</view>
          </view>
          <view wx:if="{{departureCheck}}" class="sub">
            {{departureCheck.message}}
            <view wx:if="{{departureCheck.tripImpact}}">预计结束：{{departureCheck.tripImpact.remainingEndAt}}</view>
            <view wx:for="{{departureCheck.tripImpact.conflicts}}" wx:key="code">{{item.message}}</view>
            <view>{{departureCheck.tripImpact.travelNote}}</view>
            <view>检查有效期两分钟，刷新或调整路线后请重新检查。</view>
          </view>
          <view wx:if="{{departureCheck.canDepart}}" class="acts">
            <view class="act act-primary" bindtap="confirmDepart">确认现在出发</view>
          </view>
        </view>
      </view>

      <view wx:if="{{teamNote}}" class="note">{{teamNote}}</view>
      <view wx:if="{{teamError}}" class="err">{{teamError}}</view>
    </view>

    <view wx:if="{{route}}" class="card">
      <view class="row">
        <text class="k">当前路线</text>
        <text class="v ok">{{route.name}}</text>
      </view>
      <view class="sub">
        真实步行路径 {{legsLoaded}} / {{legsTotal}} 段
        <block wx:if="{{legsLoading}}"> · 正在取…</block>
      </view>
      <view class="rule">
        地图上只画**真实步行路径**（沿街道）。取不到的那一段不画 ——
        两点直连会横穿街区与建筑，照着走会走进死路，比没有线更糟。
      </view>
      <view wx:if="{{legsNote}}" class="note">{{legsNote}}</view>
    </view>

    <view class="card">
      <view class="row">
        <text class="k">我的位置</text>
        <text class="v {{myPoint ? 'ok' : 'muted'}}">{{myPoint ? '已获取' : '未获取'}}</text>
      </view>
      <!--
        ⚠️ `wx:if` / `wx:else` 必须**紧挨着**，中间不能插别的 `wx:if`（2026-10-14 踩到）。
        第一版把精度告警插在这两者之间，`wx:else` 就不再配对 ——
        **模板编译不过，整页都不渲染**（用户看到的是"我的位置卡片整个没了"）。
        告警现在放到 if/else 之后，作为独立块，用预计算好的布尔量而不是内联 `>`。
      -->
      <view wx:if="{{myPoint}}" class="sub">
        来源：{{mySource === 'gps' ? '定位接口（GCJ-02）' : '手动选点'}}
        <block wx:if="{{myAccuracyM}}"> · 精度约 {{myAccuracyM}} 米</block>
        <block wx:if="{{myLocatedAt}}"> · {{myLocatedAt}} 取得</block>
        · 经纬度 {{myPoint.latitude}}, {{myPoint.longitude}}
      </view>
      <view wx:else class="sub">
        可自动获取当前位置；若定位不可用，也可在地图上手动点选。
      </view>

      <view wx:if="{{myAccuracyBad}}" class="note warn">
        这次定位精度只有约 {{myAccuracyM}} 米 —— 多半是室内、地下或刚开机还没定上卫星。
        精度差的时候，基于它算的"我要走多久"会明显失真，建议走到室外重新取一次。
      </view>

      <!--
        ⚠️ 「获取我的位置」与「手动选点」都挪到**地图右下角的小控件**了
        （2026-10-14 用户要求）。这里只留一行说明，不再放大按钮 ——
        两处都能干同一件事会让人不知道该点哪个。
      -->
      <view class="sub">用地图右下角的控件：◎ 取我的位置；✛ 拖动地图选**集合点**。</view>
      <view wx:if="{{note}}" class="note">{{note}}</view>
    </view>

    <view class="card" wx:if="{{nearby.length}}">
      <view class="row">
        <text class="k">集合点候选</text>
        <text class="v muted">按步行时间排序</text>
      </view>
      <view
        wx:for="{{nearby}}"
        wx:key="placeId"
        class="item"
        data-placeid="{{item.placeId}}"
        bindtap="selectMeeting"
      >
        <view class="item-main">
          <text class="item-name">{{item.name}}</text>
          <text class="item-cat">{{item.category}}</text>
        </view>
        <view class="item-right">
          <text class="mins">{{item.minutes}} 分钟</text>
          <text class="meters">{{item.meters}} 米</text>
        </view>
      </view>
      <view class="rule">个人参考：直线距离乘绕行系数估算，并非小队路网推荐。</view>
    </view>

    <view wx:if="{{meetingPoint}}" class="card sel">
      <view class="row">
        <text class="k">{{meetingPoint.fromTeamTask ? '进行中的集合' : '已选集合点'}}</text>
        <text class="v ok">{{meetingPoint.name}}</text>
      </view>
      <view class="sub">地图上的橙针即该点，虚线为步行方向（正式版将显示后端计算的实际步行路径）</view>
      <view class="sub">点地图上任意一个图钉，也可以改选集合点。</view>
      <button wx:if="{{!meetingPoint.fromTeamTask}}" class="btn ghost" bindtap="clearMeeting">取消选择</button>

      <button class="btn ghost" bindtap="fetchPhotos" disabled="{{photoBusy}}">
        {{photoBusy ? '正在取照片…' : '取这个地方的照片'}}
      </button>
      <view wx:if="{{photoNote}}" class="note">{{photoNote}}</view>

      <!--
        ⚠️ 照片列表由 JS 算成 `currentPhotos`，模板不做数组索引。
        原来写的是 `photos[meetingPoint.placeId].photos` ——
        有 `wx:if` 守卫时能跑，但**同一行里取两次、其中一次在守卫之外**，
        以后有人改动条件就很容易漏掉守卫。
        与「我的」页白屏同一类问题：模板里先索引再取属性，取不到就整页不渲染。
      -->
      <block wx:if="{{currentPhotos.length}}">
        <view class="row">
          <text class="k">照片</text>
          <text class="v muted">来自网络 · 未实地核验</text>
        </view>
        <view class="photos">
          <view
            class="shot"
            wx:for="{{currentPhotos}}"
            wx:key="url"
            wx:for-item="ph"
          >
            <image wx:if="{{ph.fileID}}" class="shot-img" src="{{ph.fileID}}" mode="aspectFill" />
            <view wx:else class="shot-img missing">未能保存</view>
            <text wx:if="{{ph.title}}" class="shot-title">{{ph.title}}</text>
          </view>
        </view>
        <view class="rule">
          这些照片用于辨认地点，**不构成**对可达性、入口位置的核验。
          该地点的核验等级以「{{meetingPoint.verified ? '已实地核验' : '未实地核验'}}」为准。
        </view>
      </block>
    </view>

    <view wx:if="{{!places.length && !loading}}" class="card">
      <view class="hint">
        数据库里暂时没有地点数据。可先手动选点，核验地点将在踏勘后录入。
      </view>
    </view>

    <view class="foot">
      地点数据来自已录入地点；集合位置由成员共同确认。
    </view>
  </view>
</view>

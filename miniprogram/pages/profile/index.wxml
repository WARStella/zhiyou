<view class="page">

  <!-- ══════════ 个人资料 ══════════ -->
  <view class="card prof">
    <!-- 头像和昵称并排，用户身份标识仅供程序内部使用。 -->
    <view class="prof-header">
      <view class="prof-avatar">
        <button class="avatar-btn" size="mini" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{saving}}">
          <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
          <view wx:else class="avatar-fallback" style="background: {{avatarColor}}">{{initial}}</view>
        </button>
        <text class="avatar-hint">点击更换头像</text>
      </view>
      <view class="prof-main">
        <!-- 昵称：默认只读，点「编辑」才变输入框，避免误改 -->
        <block wx:if="{{!editingNickname}}">
          <view class="prof-name-row">
            <text class="prof-name">{{nicknameDisplay}}</text>
            <text class="prof-edit" bindtap="startEditNickname">编辑</text>
          </view>
        </block>
        <block wx:else>
          <view class="prof-name-row">
            <input
              class="prof-input"
              value="{{nicknameDraft}}"
              placeholder="输入昵称"
              maxlength="20"
              bindinput="onNicknameInput"
              focus
            />
          </view>
          <view class="prof-name-row">
            <text class="prof-save" bindtap="saveNickname">保存</text>
            <text class="prof-cancel" bindtap="cancelEditNickname">取消</text>
          </view>
        </block>

        <view class="sub">昵称用于队伍显示，可以重名。</view>
      </view>
    </view>


  </view>


  <view wx:if="{{error}}" class="err">{{error}}</view>

  <!-- 设置 -->
  <view class="card settings-list">
    <view class="row settings-head"><text class="k">设置</text></view>
    <view class="row settings-row" bindtap="openAiSettings" aria-role="button"><text class="k">AI 与语音设置</text><text class="v link">选择平台与模型 ›</text></view>
    <view class="row settings-row setting-sharing">
      <text class="k">自动共享位置</text>
      <switch checked="{{locationSharing}}" disabled="{{locationSharingBusy || !sharingCrewId}}"
        bindchange="onLocationSharingChange" color="#0FA98A" />
    </view>
    <view class="sub">{{!sharingCrewId ? '加入小队后可开启。' : locationSharing ? (locationSharingActive ? '已开启，正在前台自动更新位置。' : '共享已开启，定位暂未运行。') : '已关闭，队友看不到你的位置。'}}</view>
    <view wx:if="{{locationSharingBusy}}" class="sharing-summary" aria-live="polite">正在处理共享设置，请稍候…</view>
    <view class="sharing-summary">仅本队可见 · 前台更新 · 可随时关闭</view>
    <view class="sharing-disclosure" bindtap="toggleLocationDetails" aria-role="button" aria-expanded="{{locationDetailsOpen}}">{{locationDetailsOpen ? '收起共享说明 ▴' : '查看更新方式与隐私说明 ▾'}}</view>
    <block wx:if="{{locationDetailsOpen}}"><view class="sub">开启后进入「队伍」立即更新；前台每 15 秒处理定位，移动超过 20 米上传，静止每 60 秒更新。切到后台暂停。</view>
    <view class="sub">开启表示同意将精确位置上传，用于向本队成员显示位置及推荐集合点。位置保留 7 天；关闭后停止上传并对队友隐藏，已有记录按保留期清理。系统记录本次同意的说明版本和时间；仅取得微信定位权限不会自动开启共享。</view></block>
    <view wx:if="{{locationSharingError}}" class="err">{{locationSharingError}}</view>
    <button wx:if="{{sharingCrewId && locationSharingError}}" class="btn ghost small"
      disabled="{{locationSharingBusy}}" bindtap="retryLocationSharing">重试位置共享设置</button>
    <view class="row settings-row setting-travel">
      <text class="k">默认出行方式</text>
      <picker
        mode="selector"
        range="{{travelModeOptions}}"
        range-key="label"
        value="{{travelModeIndex}}"
        bindchange="onTravelModeChange"
      >
        <!--
          ⚠️ **不要写 `{{travelModeOptions[travelModeIndex].label}}`**。

          这个选项表是 `user.getProfile` 回来之后才填的，而首帧它是**空数组** ——
          于是 `[0]` 是 `undefined`，读 `.label` 直接抛
          `Cannot read properties of undefined (reading '0')`，
          整个页面白屏。`|| '自动'` 兜不住：它在**取完属性之后**才生效。

          所以在 JS 里算好一个字符串（`travelModeLabel`），模板只做插值。
          数组为空时那个字段是 `'自动'`，不会崩。
        -->
        <view class="v link">{{travelModeLabel}}</view>
      </picker>
    </view>
    <view class="sub">
      生成路线时优先使用此方式；无法使用时会提供其他方式并说明原因，也可以在行程中逐段调整。
    </view>
  </view>

  <!-- ══════════ 提醒设置（2026-10-24 从队伍页移入）══════════ -->
  <view class="card notify-card">
    <view class="row settings-head"><text class="k">提醒设置</text></view>
    <view class="sub">关闭小程序后也能收到这些提醒；每次同意大约可用一次，微信按次数消耗。</view>
    <view wx:if="{{!teamCrewId}}" class="sub">加入小队后可设置集合通知、状态变更通知和消息未读提醒。</view>
    <block wx:else>
      <view wx:if="{{notifyLoading}}" class="notify-note">正在读取提醒设置…</view>
      <view wx:if="{{notifyLoadError}}" class="err">{{notifyLoadError}}</view>
      <button wx:if="{{notifyLoadError || (!notifyLoading && !notifyRows.length)}}" class="btn ghost small"
        bindtap="loadNotifyStatus" disabled="{{notifyLoading || notifyBusy}}">重新读取提醒设置</button>
      <view wx:for="{{notifyRows}}" wx:key="kind" class="notify-row">
        <view class="notify-info">
          <text class="notify-label">{{item.label}}</text>
          <text class="notify-state {{item.subscribed ? 'on' : ''}}">{{item.subscribed ? '已开启' : '未开启'}}</text>
        </view>
        <button wx:if="{{!item.subscribed}}" class="notify-btn" data-kind="{{item.kind}}"
          disabled="{{notifyBusy || notifyLoading || !item.canRequest}}"
          bindtap="requestNotify">{{notifyBusy ? '处理中…' : item.canRequest ? '开启' : '模板未就绪'}}</button>
        <button wx:else class="notify-btn notify-off" data-kind="{{item.kind}}"
          disabled="{{notifyBusy || notifyLoading}}" bindtap="revokeNotify">{{notifyBusy ? '处理中…' : '关闭'}}</button>
      </view>
      <view class="notify-note">{{notifyNote}}</view>
      <view class="notify-note">{{notifyPolicyNote || '已同意 ≠ 一定送达；每次同意大约可用一次，微信按次数消耗。'}}</view>
      <button wx:if="{{notifySettingsNeeded}}" class="btn ghost small" bindtap="openNotifySettings">前往微信订阅设置</button>
    </block>
  </view>

  <!-- ══════════ 小队与集合 ══════════ -->
  <!--
    完整的小队面板挪到这里（2026-10-14 用户要求）。
    此前它挂在行程页顶部，折叠着也占位置，而组队配置属于设置、不是行程内容。

    ⚠️ `personal-trip-id` 从本地读（`loadActiveTripId`），不是从行程对象 ——
    这一页手上没有行程对象。传空串时组件会提示"请先在行程页生成个人路线"，
    那正是事实。
    ⚠️ `source` 要有空串兜底：它声明为 String 属性，而小程序里
    **属性传 null 不算"没传"**，会覆盖掉组件的默认值。
  -->
  <team-panel
    id="profile-team"
    personal-trip-id="{{personalTripId}}"
    point="{{myPoint}}"
    source="{{mySource || ''}}"
    bind:teamstate="onTeamState"
  />

  <!-- ══════════ 开发工具 ══════════ -->
  <button class="section-toggle support-toggle" bindtap="toggleTools" aria-expanded="{{toolsOpen}}">帮助与调试 {{toolsOpen ? '收起 ▴' : '展开 ▾'}}</button>
  <view wx:if="{{toolsOpen}}" class="card">
    <view class="row">
      <text class="k">开发工具</text>
    </view>
    <view class="sub">
      遇到连接问题时，可运行自检并将结果提供给开发人员。
    </view>
    <button class="btn ghost small" bindtap="openSelfCheck">打开联调自检</button>
  </view>

  <view class="foot">智游·灵动 · 游览路线协同</view>
</view>

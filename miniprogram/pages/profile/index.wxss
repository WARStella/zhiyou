/* 「我的」页（2026-10-14） */

.page {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f6f8;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  color: #20334a;
  font-size: 27rpx;
  line-height: 1.7;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.k {
  color: #65758a;
  font-size: 25rpx;
}

.v {
  font-size: 27rpx;
}

.link {
  color: #0b3c6e;
  font-weight: 600;
}

.sub {
  font-size: 22rpx;
  color: #9aa5b1;
  margin-top: 8rpx;
  line-height: 1.7;
}

.err {
  color: #aa3028;
  background: #fff0ed;
  padding: 16rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
}

/* ── 个人资料 ──────────────────────────────────────────── */

/*
 * ⚠️ **不要 `align-items: center`**（2026-10-14 改）。
 *
 * 用户 ID 是 28 位，必然折行。居中会让头像停在"名字+ID"整块的中线，
 * 看起来像飘在半空；而折行后的"复制"又被挤到第三行，更难读。
 *
 * 现在：头像顶部对齐，右侧一栏里用户名与 ID 各占一行、ID 缩进在名字下面。
 */
.prof {
  display: flex;
  align-items: flex-start;
}

/*
 * 头像按钮。
 *
 * ⚠️ 两层坑，都是踩过才知道的（2026-10-14）：
 *
 * ① `<button open-type="chooseAvatar">` 自带默认样式 —— 灰底、边框、
 *    内边距、以及一个 `::after` 画的圆角边框。不清掉的话头像外面会套方框。
 *    必须重置 `padding` / `background` / `border` / `line-height`，
 *    并把 `::after` 的 border 去掉。
 *
 * ② **不要在 button 上做圆形裁剪**。我第一版给 button 设了
 *    `border-radius: 50%` + `overflow: hidden`，而里面的元素**也是**
 *    `border-radius: 50%` —— 两个椭圆叠加 + button 默认样式的干扰，
 *    裁出来是个**歪的半个椭圆**（用户截图看到的就是这个）。
 *
 *    现在：button 只负责"可点 + 尺寸"，圆形一律由**里面那个元素**负责。
 *    一层裁剪，不会有叠加误差。
 */
.avatar-btn {
  width: 132rpx;
  height: 132rpx;
  padding: 0;
  margin: 0 24rpx 0 0;
  background: transparent;
  border: none;
  line-height: 1;
  flex-shrink: 0;
  /* 顶部对齐 —— 见 .prof 的说明（ID 必然折行，居中会飘） */
  align-self: flex-start;
  /* 显式声明，避免 button 默认的 inline-block 基线对齐带来几像素偏移 */
  display: block;
  vertical-align: top;
}
.avatar-btn::after {
  border: none;
}
.avatar-img {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  display: block;
}
/* 没头像时用昵称首字 + 稳定底色，不塞假图片 */
.avatar-fallback {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 52rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.prof-main {
  flex: 1;
  min-width: 0;
}
.prof-name-row {
  display: flex;
  align-items: center;
}
.prof-name {
  font-size: 34rpx;
  font-weight: 700;
}
.prof-edit {
  margin-left: 16rpx;
  font-size: 23rpx;
  color: #0b3c6e;
  border: 1rpx solid #0b3c6e;
  border-radius: 8rpx;
  padding: 0 12rpx;
}
.prof-input {
  flex: 1;
  background: #f3f6fa;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
}
.prof-save {
  font-size: 23rpx;
  color: #fff;
  background: #0b3c6e;
  border-radius: 8rpx;
  padding: 4rpx 18rpx;
  margin-right: 16rpx;
}
.prof-cancel {
  font-size: 23rpx;
  color: #65758a;
}

/* 用户编号：可点按复制。
   短号 6 位、一行放得下；完整 ID 只作参考，小字折行显示。 */
.prof-id {
  margin-top: 10rpx;
}
/* 标签与"复制"同一行，值单独一行 */
.prof-id-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.prof-id-label {
  font-size: 21rpx;
  color: #9aa5b1;
}
.prof-id-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #0b3c6e;
  /* 等宽 + 字距：念号、抄号时不易看错 */
  font-family: monospace;
  letter-spacing: 4rpx;
}
.prof-id-copy {
  font-size: 21rpx;
  color: #0b3c6e;
  white-space: nowrap;
}

/* ── 按钮 ──────────────────────────────────────────────── */

.btn {
  background: #0b3c6e;
  color: #fff;
  font-size: 26rpx;
  border-radius: 12rpx;
  margin-top: 16rpx;
}
.btn.ghost {
  background: #fff;
  color: #0b3c6e;
  border: 2rpx solid #0b3c6e;
}
/*
 * 禁用态。属性选择器在 WXSS 里**不生效**（编译器会警告），
 * 所以按类名 + 伪类写。
 */
.btn.button-disabled,
.btn:disabled {
  background: #9aa5b1;
  color: #fff;
}
.btn.ghost.button-disabled,
.btn.ghost:disabled {
  color: #9aa5b1;
  border-color: #cfd6dd;
}
.btn.small {
  font-size: 24rpx;
}

.foot {
  text-align: center;
  font-size: 20rpx;
  color: #b8c2cc;
  margin: 30rpx 0 20rpx;
}
